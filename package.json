{
  "name": "awesome-cheatsheets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Awesome AI Cheatsheets — authoring tools and template contract.",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "INCLUDE_E2E_FIXTURES=1 astro build && pagefind --site dist && playwright test",
    "cheatsheet:lint": "tsx tools/cli/lint.ts",
    "check:no-cdn": "bash tools/ci/no-cdn-check.sh dist",
    "freshness:scan": "tsx tools/ci/freshness-scan.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@astrojs/mdx": "^3.1.9",
    "@astrojs/tailwind": "^5.1.5",
    "astro": "^4.16.19",
    "fast-glob": "^3.3.3",
    "mdast-util-to-string": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^3.4.19",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.0",
    "@types/unist": "^3.0.3",
    "pagefind": "^1.5.2",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
