{
  "name": "awesome-cheatsheets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Awesome AI Cheatsheets — authoring tools and template contract.",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "INCLUDE_E2E_FIXTURES=1 astro build && pagefind --site dist && playwright test",
    "cheatsheet:lint": "tsx tools/cli/lint.ts",
    "check:no-cdn": "bash tools/ci/no-cdn-check.sh dist",
    "freshness:scan": "tsx tools/ci/freshness-scan.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "fast-glob": "^3.3.3",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/jsdom": "^28.0.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.6",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^29.1.1",
    "pagefind": "^1.5.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "tmp": ">=0.2.6 <1",
      "undici@<8": ">=7.29.0 <8",
      "ws@<8": ">=7.5.11 <8",
      "ws@>=8 <9": ">=8.21.0 <9",
      "vite@>=8 <9": ">=8.0.16 <9",
      "brace-expansion@<2": ">=1.1.18 <2",
      "js-yaml@<4": ">=3.15.2 <4",
      "ip-address": ">=10.3.1 <11",
      "nanoid@<4": ">=3.3.18 <4",
      "postcss@<9": ">=8.5.23 <9",
      "browserslist": ">=4.28.7 <5",
      "baseline-browser-mapping": ">=2.11.0 <3",
      "qs": ">=6.16.0 <7",
      "body-parser": ">=1.20.6 <2",
      "devalue": ">=5.9.2 <6",
      "dompurify": ">=3.4.13 <4",
      "postcss-selector-parser": ">=6.1.3 <7",
      "esbuild@<1": ">=0.28.1 <0.29",
      "lodash-es@<4.18": ">=4.18.1 <5",
      "puppeteer-core>@puppeteer/browsers": "^3.2.3"
    }
  }
}
