---
import CheatsheetLayout from '../../layouts/CheatsheetLayout.astro';

const staleFrontmatter = {
  title: 'Test Stale Cheatsheet',
  summary: 'A test cheatsheet with a stale last_updated date to verify banner rendering.',
  category: 'tool' as const,
  tags: ['test'],
  last_updated: '2020-01-01',
  stale_after_days: 1,
};
---

<CheatsheetLayout title={staleFrontmatter.title} frontmatter={staleFrontmatter}>
  <div class="cheatsheet-body">
    <p>Test content for stale banner verification.</p>
  </div>
</CheatsheetLayout>