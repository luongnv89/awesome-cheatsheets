---
/**
 * Custom 404 page (issue #27).
 *
 * Astro emits `src/pages/404.astro` to `dist/404.html`, which GitHub Pages
 * serves for any unmatched path under the configured base. Styled to mirror
 * the catalog landing hero (`src/pages/index.astro`) so the chrome stays
 * cohesive — same `<Layout>`, same typography, same max-width container.
 *
 * This is a top-level chrome page, NOT a cheatsheet detail page: it uses the
 * base `Layout.astro` and intentionally does NOT use `CheatsheetLayout.astro`
 * (which is reserved for content-collection entries with the locked 7-section
 * structure).
 *
 * Internal links honor the configured base (`/awesome-cheatsheets`) via
 * `import.meta.env.BASE_URL`, so they resolve correctly on GitHub Pages.
 */
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const catalogHref = `${baseUrl}/`;
const aboutHref = `${baseUrl}/about/`;
---

<Layout title="Page not found — Awesome AI Cheatsheets">
  <main class="catalog-main">
    <header class="catalog-hero">
      <p class="not-found-eyebrow" aria-hidden="true">404</p>
      <h1 class="catalog-hero-title">Page not found</h1>
      <p class="catalog-hero-lede">
        We couldn't find that cheatsheet. It may have been renamed, removed,
        or never existed. Head back to the catalog or learn more about the
        project.
      </p>
    </header>

    <section class="not-found-actions" aria-label="Where to next">
      <ul class="not-found-link-list" role="list">
        <li>
          <a class="not-found-link" href={catalogHref}>
            Browse all cheatsheets
          </a>
        </li>
        <li>
          <a class="not-found-link" href={aboutHref}>
            About this project
          </a>
        </li>
      </ul>
    </section>
  </main>
</Layout>

<style is:global>
  /*
   * Catalog hero typography — duplicated here intentionally so the 404 page
   * styles even when the catalog landing page's stylesheet isn't loaded.
   * (Astro scopes `is:global` stylesheets per route; the rules in
   * `index.astro` ship only with `dist/index.html`.) Keep these in sync with
   * `src/pages/index.astro` and `src/pages/about.astro`.
   */
  .catalog-main {
    max-width: 760px;
    margin: 0 auto;
    padding: 4rem 1.25rem 4rem;
  }

  .catalog-hero {
    margin-bottom: 2rem;
  }

  .catalog-hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.05;
    margin: 0 0 1.25rem 0;
    color: var(--color-ink);
    letter-spacing: -0.015em;
  }

  .catalog-hero-lede {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 60ch;
    margin: 0;
  }

  .catalog-hero-lede strong {
    color: var(--color-ink);
    font-weight: 700;
  }

  /* 404-specific rules. The eyebrow is a quiet, mono-styled "404" stamped
     above the heading — the page-itself feels like a found note rather than
     a system error. */
  .not-found-eyebrow {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-amber-deep);
    background-color: var(--color-paper-shade);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    padding: 0.375rem 0.875rem;
    display: inline-block;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }

  .not-found-actions {
    margin-top: 2rem;
    padding: 1.5rem;
    background-color: #fff;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
  }

  .not-found-link-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 640px) {
    .not-found-link-list {
      flex-direction: row;
      gap: 1rem;
    }
  }

  .not-found-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.125rem;
    color: var(--color-ink);
    background-color: var(--color-amber);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-amber-deep);
    transition: background-color 0.12s ease, transform 0.12s ease;
  }
  .not-found-link:hover {
    background-color: #FFCD3A;
    transform: translateY(-1px);
  }
  .not-found-link:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
  .not-found-link + .not-found-link,
  .not-found-link-list li:nth-child(2) .not-found-link {
    background-color: #fff;
    border-color: var(--color-rule);
    color: var(--color-ink);
  }
  .not-found-link-list li:nth-child(2) .not-found-link:hover {
    background-color: var(--color-paper-shade);
  }
</style>
