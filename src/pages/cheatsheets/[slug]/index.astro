---
import { getCollection } from 'astro:content';
import CheatsheetLayout from '../../../layouts/CheatsheetLayout.astro';

export async function getStaticPaths() {
  const cheatsheets = await getCollection('cheatsheets');
  return cheatsheets.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const frontmatter = {
  title: entry.data.title,
  summary: entry.data.summary,
  category: entry.data.category,
  tags: entry.data.tags,
  last_updated: entry.data.last_updated,
  stale_after_days: entry.data.stale_after_days,
};

// Draft cheatsheets render at the canonical URL for review but stay out
// of the Pagefind search index (issue #90). The catalog filter in
// `src/pages/index.astro` already keeps them off the grid; the layout
// handles the `data-pagefind-body` omission when `isDraft` is true.
const isDraft = entry.data.status === 'draft';
---

<CheatsheetLayout title={entry.data.title} frontmatter={frontmatter} isDraft={isDraft}>
  <div class="cheatsheet-body">
    <Content />
  </div>
</CheatsheetLayout>

<style is:global>
  /*
   * Cheatsheet body — markdown-rendered article content, styled in the dense
   * MAG-cheatsheet aesthetic: solid dark-bar h2s with a neon-green accent,
   * tight h3s, dense tables, dark code blocks, and blockquote-as-callout.
   *
   * Brand-aligned: uses --color-ink/--color-amber tokens from
   * CheatsheetLayout.astro. Neon green is the sole accent; amber/red appear
   * only on warn callouts and the existing stale banner (chrome).
   *
   * Helper classes authors can drop into markdown for the full MAG palette:
   *   <div class="callout warn|info|tip">…</div>
   *   <div class="ascii">…ASCII box…</div>
   *   <span class="pill">label</span> · <span class="badge">label</span>
   *   <ol class="steps">…</ol>   (renders green-circle numbered steps)
   */
  .cheatsheet-body {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink);
  }

  /*
   * Newspaper-column layout — content flows top-to-bottom, then wraps into
   * the next column, packing more sections into a single view on wide
   * screens. Section bars (h2) span all columns; code blocks, tables,
   * callouts, lists, and figures keep their internal integrity via
   * `break-inside: avoid`.
   */
  @media (min-width: 1024px) {
    .cheatsheet-body {
      column-count: 2;
      column-gap: 2rem;
      column-rule: 1px solid var(--color-rule);
    }
  }
  @media (min-width: 1600px) {
    .cheatsheet-body {
      column-count: 3;
    }
  }
  .cheatsheet-body > h2 {
    column-span: all;
  }
  .cheatsheet-body pre,
  .cheatsheet-body table,
  .cheatsheet-body blockquote,
  .cheatsheet-body .callout,
  .cheatsheet-body .ascii,
  .cheatsheet-body figure,
  .cheatsheet-body ul,
  .cheatsheet-body ol,
  .cheatsheet-body .mermaid {
    break-inside: avoid;
  }
  .cheatsheet-body > h3,
  .cheatsheet-body > h4 {
    break-after: avoid;
  }

  .cheatsheet-body > * { margin-bottom: 0.85rem; }
  .cheatsheet-body > h2,
  .cheatsheet-body > h3,
  .cheatsheet-body > h4 { margin-bottom: 0.5rem; }

  /* Solid dark-bar h2 — the signature MAG section header. Switches to flex
     so an injected progress chip (Step section only) sits on the right. */
  .cheatsheet-body h2 {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    margin-top: 1.75rem;
    padding: 0.45rem 0.75rem;
    color: #fff;
    background-color: var(--color-ink);
    border-radius: var(--radius-sm);
    border-bottom: 3px solid var(--color-amber);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    page-break-after: avoid;
  }

  /* Progress chip on the Setup H2 — injected by the step-heading enhancer
     when at least one Step is present. Reads against the dark bar; flips to
     neon green fill when all steps are checked. */
  .cheatsheet-body h2 .step-progress {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.55rem;
    color: #DCFCE7;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }
  .cheatsheet-body h2 .step-progress.is-complete {
    color: var(--color-ink);
    background-color: #4ADE80;
    border-color: #4ADE80;
  }
  .cheatsheet-body > h2:first-child { margin-top: 0; }

  .cheatsheet-body h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    margin-top: 1.1rem;
    color: var(--color-ink);
    page-break-after: avoid;
  }

  /* Step headings (rewritten client-side from `### Step N — Title`).
     Checkbox, pill badge, and bare title in one row above the body. Gives
     scannable "newspaper section break" separation between setup steps,
     plus a one-click way to mark a step as done — checked state persists
     per-cheatsheet via localStorage. */
  .cheatsheet-body h3.step-heading {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    column-gap: 0.55rem;
    row-gap: 0.2rem;
    margin-top: 1.6rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--color-rule);
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  .cheatsheet-body h3.step-heading .step-checkbox {
    grid-row: 1;
    width: 1.1rem;
    height: 1.1rem;
    margin: 0;
    accent-color: #4ADE80;
    cursor: pointer;
  }
  .cheatsheet-body h3.step-heading .step-badge {
    grid-row: 1;
    padding: 0.1rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    background-color: #4ADE80;
    border-radius: var(--radius-sm);
  }
  .cheatsheet-body h3.step-heading .step-title {
    grid-column: 2 / -1;
    grid-row: 2;
    color: var(--color-ink);
  }

  /* Done state — strike the title and fade the body, but keep things
     readable (lower opacity, not invisible) so the user can still re-check
     what they completed. */
  .cheatsheet-body h3.step-heading.is-done .step-title {
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-ink-soft);
    color: var(--color-ink-soft);
  }
  .cheatsheet-body h3.step-heading.is-done .step-badge {
    background-color: var(--color-rule);
    color: var(--color-ink-soft);
  }
  .cheatsheet-body .step-done-body {
    opacity: 0.45;
    transition: opacity 0.15s;
  }
  .cheatsheet-body .step-done-body:hover {
    opacity: 1;
  }

  .cheatsheet-body h4 {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
    margin-top: 0.9rem;
    color: var(--color-ink);
  }

  .cheatsheet-body p,
  .cheatsheet-body li {
    color: var(--color-ink);
    line-height: 1.55;
  }

  .cheatsheet-body a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-amber);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .cheatsheet-body a:hover { color: var(--color-amber-deep); }

  .cheatsheet-body ul,
  .cheatsheet-body ol {
    padding-left: 1.4rem;
    margin: 0.25rem 0 0.85rem;
  }
  .cheatsheet-body li { margin-bottom: 0.2rem; }
  .cheatsheet-body li > ul,
  .cheatsheet-body li > ol { margin: 0.25rem 0 0.25rem; }

  /* Blockquote → tip callout: green left border + paper-shade fill. Pairs
     with the > "Why:" / > "Pro tip:" markdown convention used by the
     cheatsheets. */
  .cheatsheet-body blockquote {
    border-left: 3px solid var(--color-amber);
    background-color: var(--color-paper-shade);
    padding: 0.6rem 0.9rem;
    margin: 0.75rem 0;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--color-ink);
    font-size: 0.9rem;
    page-break-inside: avoid;
  }
  .cheatsheet-body blockquote p { margin: 0; }
  .cheatsheet-body blockquote p + p { margin-top: 0.35rem; }

  /* Manual callout classes — drop <div class="callout warn"> into markdown
     when a section needs a stronger visual flag than a blockquote. */
  .cheatsheet-body .callout {
    border-left: 3px solid;
    padding: 0.6rem 0.9rem;
    margin: 0.75rem 0;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 0.9rem;
    page-break-inside: avoid;
  }
  .cheatsheet-body .callout.tip   { background-color: var(--color-paper-shade); border-color: var(--color-amber); }
  .cheatsheet-body .callout.info  { background-color: #EFF6FF;                  border-color: #2563EB; color: #1E3A8A; }
  .cheatsheet-body .callout.warn  { background-color: #FEF2F2;                  border-color: #DC2626; color: #7F1D1D; }
  .cheatsheet-body .callout p     { margin: 0; }
  .cheatsheet-body .callout p + p { margin-top: 0.35rem; }

  /* Reference / collapsible sections. */
  .cheatsheet-body details {
    margin: 0.75rem 0;
    padding: 0.75rem 0.9rem;
    background-color: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    page-break-inside: avoid;
  }
  .cheatsheet-body details summary {
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    color: var(--color-ink);
  }
  .cheatsheet-body details summary::-webkit-details-marker { display: none; }
  .cheatsheet-body details summary::before {
    content: "▸";
    display: inline-block;
    margin-right: 0.4rem;
    color: var(--color-amber-deep);
    transition: transform 0.2s;
  }
  .cheatsheet-body details[open] summary::before { transform: rotate(90deg); }
  .cheatsheet-body details[open] summary { margin-bottom: 0.5rem; }

  /* Dark code blocks for high syntax contrast. Tightened for density. */
  .cheatsheet-body pre {
    padding: 0.7rem 0.95rem;
    background-color: var(--color-ink);
    color: #DCFCE7;
    border-radius: var(--radius-sm);
    overflow-x: auto;
    margin: 0.4rem 0 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    border: 1px solid var(--color-ink-soft);
    page-break-inside: avoid;
  }

  /* Copy button — injected client-side by CheatsheetLayout. The wrapper is
     positioned so the absolute button sits in the top-right corner; the
     wrapper inherits the <pre>'s natural margin (the <pre> resets its own
     margin once wrapped). */
  .cheatsheet-body .code-block {
    position: relative;
    margin: 0.4rem 0 0.75rem;
  }
  .cheatsheet-body .code-block > pre { margin: 0; }
  .cheatsheet-body .code-block-copy {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    padding: 0.2rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
    color: #DCFCE7;
    background-color: var(--color-ink-soft);
    border: 1px solid #4ADE80;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .cheatsheet-body .code-block-copy:hover {
    background-color: #4ADE80;
    color: var(--color-ink);
  }
  .cheatsheet-body .code-block-copy.is-copied {
    background-color: #4ADE80;
    color: var(--color-ink);
    border-color: #4ADE80;
  }
  .cheatsheet-body .code-block-copy.is-failed {
    background-color: #DC2626;
    color: #fff;
    border-color: #DC2626;
  }
  @media print {
    .cheatsheet-body .code-block-copy { display: none; }
  }

  .cheatsheet-body code {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .cheatsheet-body p code,
  .cheatsheet-body li code,
  .cheatsheet-body td code,
  .cheatsheet-body th code {
    background-color: var(--color-paper-shade);
    color: var(--color-ink);
    padding: 0.05rem 0.35rem;
    border-radius: 0.25rem;
    border: 1px solid var(--color-rule);
    font-size: 0.85em;
  }

  /* Dense reference tables — header row in paper-shade, rule lines between
     rows only. Wraps don't break inside on print. */
  .cheatsheet-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 0.5rem 0 0.9rem;
    font-size: 0.875rem;
    page-break-inside: auto;
  }
  .cheatsheet-body th,
  .cheatsheet-body td {
    padding: 0.4rem 0.6rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-rule);
  }
  .cheatsheet-body th {
    background-color: var(--color-paper-shade);
    color: var(--color-ink);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
  }

  /* ASCII / pre-rendered diagrams — light paper, monospaced, no break. */
  .cheatsheet-body .ascii {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.35;
    background-color: #fff;
    border: 1px solid var(--color-rule);
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    white-space: pre;
    overflow-x: auto;
    margin: 0.5rem 0 0.9rem;
    page-break-inside: avoid;
  }

  /* Pills (small inline counters) and badges (status chips). */
  .cheatsheet-body .pill,
  .cheatsheet-body .badge {
    display: inline-block;
    padding: 0.05rem 0.55rem;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 600;
    border: 1px solid var(--color-rule);
    background-color: var(--color-paper-shade);
    color: var(--color-ink);
    vertical-align: middle;
  }
  .cheatsheet-body .badge.warn { background-color: #FEF2F2; border-color: #DC2626; color: #7F1D1D; }
  .cheatsheet-body .badge.info { background-color: #EFF6FF; border-color: #2563EB; color: #1E3A8A; }

  /* Numbered green-circle steps — apply by authoring <ol class="steps">. */
  .cheatsheet-body ol.steps {
    list-style: none;
    counter-reset: step;
    padding-left: 0;
  }
  .cheatsheet-body ol.steps > li {
    counter-increment: step;
    position: relative;
    padding: 0.1rem 0 0.3rem 2rem;
    margin-bottom: 0.4rem;
  }
  .cheatsheet-body ol.steps > li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.1rem;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background-color: var(--color-amber);
    color: var(--color-ink);
    font-weight: 700;
    font-size: 0.8125rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Mermaid diagrams are emitted into a wrapper div by the remark plugin —
     give them breathing room without competing with the dense layout. */
  .cheatsheet-body .mermaid {
    margin: 0.75rem 0 1rem;
    padding: 0.5rem;
    background-color: #fff;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    text-align: center;
    page-break-inside: avoid;
  }
  .cheatsheet-body .mermaid svg { max-width: 100%; height: auto; }

  @media (max-width: 640px) {
    .cheatsheet-body { font-size: 0.9375rem; }
    .cheatsheet-body pre { font-size: 0.75rem; }
    .cheatsheet-body table { font-size: 0.8125rem; }
  }

  @media print {
    .cheatsheet-body pre,
    .cheatsheet-body table,
    .cheatsheet-body .ascii,
    .cheatsheet-body .callout,
    .cheatsheet-body blockquote,
    .cheatsheet-body .mermaid { page-break-inside: avoid; }
    .cheatsheet-body h2,
    .cheatsheet-body h3 { page-break-after: avoid; }
  }
</style>