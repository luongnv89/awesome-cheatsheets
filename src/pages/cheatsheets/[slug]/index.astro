---
import { getCollection } from 'astro:content';
import CheatsheetLayout from '../../../layouts/CheatsheetLayout.astro';

export async function getStaticPaths() {
  const cheatsheets = await getCollection('cheatsheets');
  return cheatsheets.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const frontmatter = {
  title: entry.data.title,
  summary: entry.data.summary,
  category: entry.data.category,
  tags: entry.data.tags,
  last_updated: entry.data.last_updated,
  stale_after_days: entry.data.stale_after_days,
};
---

<CheatsheetLayout title={entry.data.title} frontmatter={frontmatter}>
  <div class="cheatsheet-body">
    <Content />
  </div>
</CheatsheetLayout>

<style is:global>
  .cheatsheet-body > *:not(h2):not(details) {
    margin-bottom: 1rem;
  }

  .cheatsheet-body h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .cheatsheet-body details {
    margin-top: 1rem;
    padding: 1rem;
    background-color: #f3f4f6;
    border-radius: 0.5rem;
  }

  .cheatsheet-body details summary {
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .cheatsheet-body details summary::-webkit-details-marker {
    display: none;
  }

  .cheatsheet-body details[open] summary {
    margin-bottom: 0.5rem;
  }

  .cheatsheet-body pre {
    padding: 1rem;
    background-color: #24292e;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .cheatsheet-body code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
  }

  .cheatsheet-body p code {
    background-color: #f3f4f6;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
  }
</style>