---
/**
 * Catalog / landing page — search-first.
 *
 * Lists every published entry in the `cheatsheets` content collection with
 * title, one-liner summary, category, tags, `last_updated`, step count, and
 * a progress strip hydrated from `cheatsheet-progress:<slug>` in
 * localStorage. Statically rendered at build (Astro's default
 * `output: 'static'`).
 *
 * Hierarchy: hero (search is the dominant control) → filter pills → grid.
 * Internal links honor the configured base path (`/awesome-cheatsheets`).
 */
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CatalogCard from '../components/CatalogCard.astro';
import CatalogSearch from '../components/CatalogSearch.astro';
import FilterPills from '../components/FilterPills.astro';
import { countSteps } from '../lib/steps';
import '../styles/hero.css';

const entries = await getCollection('cheatsheets', ({ data }) => {
  // Only "published" cheatsheets surface in the catalog grid, the search
  // index, and the filter facet counts (issue #90). Drafts and PoCs stay
  // out of the listing but their detail pages still render at
  // /cheatsheets/<slug>/ so reviewers can read them by direct URL.
  // Deprecated entries are also hidden. The schema defaults `status` to
  // "published" so omitting the field keeps an entry visible.
  return data.status === 'published';
});

// Sort newest first by last_updated (ISO-8601 strings sort lexicographically).
const sorted = [...entries].sort((a, b) =>
  b.data.last_updated.localeCompare(a.data.last_updated),
);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const cheatsheetHref = (slug: string) => `${baseUrl}/cheatsheets/${slug}/`;

// Unique facet sets for the filter pills (issue #22). Categories follow the
// schema enum order so the UI stays stable as the corpus grows; tags are
// emitted in alphabetical order for deterministic rendering and predictable
// e2e selectors. Both lists are derived from the visible corpus only — no
// pills for facets that have zero matching entries.
const CATEGORY_ORDER = ['tool', 'mcp', 'concept', 'comparison'] as const;
const categoriesInCorpus = new Set(sorted.map((e) => e.data.category));
const filterCategories = CATEGORY_ORDER.filter((c) => categoriesInCorpus.has(c));
// Tags are ordered by corpus frequency (ties alphabetical) so the filter
// bar can lead with the most useful facets and tuck the long tail behind
// a "+N more" expander.
const tagCounts = new Map<string, number>();
for (const e of sorted) {
  for (const t of e.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
}
const filterTags = Array.from(tagCounts.keys()).sort(
  (a, b) => (tagCounts.get(b) ?? 0) - (tagCounts.get(a) ?? 0) || a.localeCompare(b),
);
---

<Layout title="Awesome AI Cheatsheets">
  <main class="catalog-main">
    <header class="catalog-hero">
      <p class="catalog-hero-eyebrow" aria-hidden="true">Reference, refreshed.</p>
      <h1 class="catalog-hero-title">Awesome AI Cheatsheets</h1>
      <p class="catalog-hero-lede">
        Step-by-step setup guides for AI coding tools. Copy every command,
        track your progress, and know when a guide was last checked.
      </p>
      <div class="catalog-hero-search">
        <CatalogSearch />
      </div>
      <p class="catalog-hero-stats">
        {sorted.length} cheatsheets · updated {sorted[0]?.data.last_updated ?? ''}
      </p>
    </header>

    <FilterPills categories={filterCategories} tags={filterTags} maxVisibleTags={10} />

    <section class="catalog-section" aria-labelledby="catalog-heading">
      <h2 id="catalog-heading" class="catalog-section-title">
        Cheatsheets ({sorted.length})
      </h2>

      {sorted.length === 0 ? (
        <p class="catalog-empty">
          No cheatsheets yet. <a href={`${baseUrl}/about/`}>Contribute one</a>.
        </p>
      ) : (
        <ul class="catalog-list" role="list">
          {sorted.map((entry) => (
            <li
              class="catalog-list-item"
              data-category={entry.data.category}
              data-tags={entry.data.tags.join(' ')}
            >
              <CatalogCard
                href={cheatsheetHref(entry.id)}
                title={entry.data.title}
                summary={entry.data.summary}
                category={entry.data.category}
                tags={entry.data.tags}
                slug={entry.id}
                stepCount={countSteps(entry.body ?? '')}
                lastUpdated={entry.data.last_updated}
                staleAfterDays={entry.data.stale_after_days}
              />
            </li>
          ))}
        </ul>
      )}

      {/*
       * Zero-match empty state for the filter pills (issue #142). Always in
       * the DOM next to the grid so `filter-pills-client.ts` can reveal it
       * when the active combination hides every card; its Clear filters
       * button shares the `data-filter-clear` hook with the in-bar one, so
       * the client wires both with the same reset handler. Hidden from
       * Pagefind — UI chrome, not page content.
       */}
      <div class="catalog-filter-empty" data-pagefind-ignore hidden>
        <p class="catalog-filter-empty-text">
          No cheatsheets match the selected filters.
        </p>
        <button
          type="button"
          class="catalog-filter-empty-clear"
          data-filter-clear
          hidden
        >
          Clear filters
        </button>
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  /*
   * Page chrome only — the hero typography lives in `src/styles/hero.css`
   * (shared with about.astro + 404.astro; keep edits there). Filter-pill
   * chrome lives in `src/styles/filter-pills.css`; card chrome in
   * `CatalogCard.astro`.
   */
  .catalog-main {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 4rem;
  }

  .catalog-section-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 1rem;
  }

  .catalog-empty {
    color: var(--muted);
    font-size: 0.9375rem;
    padding: 2rem 0;
  }
  .catalog-empty a {
    color: var(--accent-text);
    text-decoration: underline;
    text-decoration-color: var(--accent-line);
    text-underline-offset: 3px;
  }

  /* Card grid — 3 cols ≥1024px, 2 ≥640px, 1 below. */
  .catalog-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 1.25rem;
  }
  @media (min-width: 640px) {
    .catalog-list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .catalog-list { grid-template-columns: repeat(3, 1fr); }
  }
  .catalog-list-item { min-width: 0; }
</style>

<script>
  // Card progress strips — each card footer carries
  // `[data-progress-slug]`; the strip is hidden until the cheatsheet has
  // at least one checked step in `cheatsheet-progress:<slug>` (the same
  // object the detail page writes, so progress follows the reader home).
  import { parseProgress } from '../components/cheatsheet/step-progress';

  document.querySelectorAll('[data-progress-slug]').forEach((el) => {
    const slug = el.getAttribute('data-progress-slug');
    const total = Number(el.getAttribute('data-step-count') ?? '0');
    if (!slug || !Number.isFinite(total) || total <= 0) return;
    let state = {};
    try {
      state = parseProgress(localStorage.getItem(`cheatsheet-progress:${slug}`));
    } catch {
      /* storage disabled — leave the strip hidden */
      return;
    }
    const done = Object.keys(state).filter(
      (k) => /^step-\d+$/.test(k) && state[k] === true,
    ).length;
    if (done === 0) return;
    const fill = el.querySelector('.catalog-card-progress-fill');
    const label = el.querySelector('.catalog-card-progress-label');
    if (fill instanceof HTMLElement) {
      fill.style.width = `${Math.min(100, (done / total) * 100)}%`;
    }
    if (label) label.textContent = `${done}/${total} done`;
    if (el instanceof HTMLElement) el.hidden = false;
  });
</script>
