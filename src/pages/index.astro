---
/**
 * Catalog / landing page.
 *
 * Lists every entry in the `cheatsheets` content collection with title,
 * one-liner summary, category, tags, and `last_updated`. Stale entries (per
 * `last_updated + stale_after_days`) get an inline "may be stale" badge in
 * the row. Statically rendered at build (Astro's default `output: 'static'`).
 *
 * The hero cites the project wedge — format + freshness + comparability — per
 * PRD §1. Internal links honor the configured base path (`/awesome-cheatsheets`).
 */
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CatalogCard from '../components/CatalogCard.astro';
import CatalogSearch from '../components/CatalogSearch.astro';
import FilterPills from '../components/FilterPills.astro';

const entries = await getCollection('cheatsheets', ({ data }) => {
  // Hide cheatsheets explicitly marked deprecated from the catalog; PoCs and
  // published entries both render. The schema defaults `status` to "published".
  return data.status !== 'deprecated';
});

// Sort newest first by last_updated (ISO-8601 strings sort lexicographically).
const sorted = [...entries].sort((a, b) =>
  b.data.last_updated.localeCompare(a.data.last_updated),
);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const cheatsheetHref = (slug: string) => `${baseUrl}/cheatsheets/${slug}/`;

// Unique facet sets for the filter pills (issue #22). Categories follow the
// schema enum order so the UI stays stable as the corpus grows; tags are
// emitted in alphabetical order for deterministic rendering and predictable
// e2e selectors. Both lists are derived from the visible corpus only — no
// pills for facets that have zero matching entries.
const CATEGORY_ORDER = ['tool', 'mcp', 'concept', 'comparison'] as const;
const categoriesInCorpus = new Set(sorted.map((e) => e.data.category));
const filterCategories = CATEGORY_ORDER.filter((c) => categoriesInCorpus.has(c));
const filterTags = Array.from(
  new Set(sorted.flatMap((e) => e.data.tags)),
).sort();
---

<Layout title="Awesome AI Cheatsheets">
  <main class="catalog-main">
    <header class="catalog-hero">
      <h1 class="catalog-hero-title">Awesome AI Cheatsheets</h1>
      <p class="catalog-hero-lede">
        Rich-format, visibly-dated, mutually-comparable references for terminal-native
        AI coding agents and the concepts behind them. Our wedge:
        <strong>format + freshness + comparability</strong> — every cheatsheet ships
        with a last-updated date and is flagged when it goes stale.
      </p>
    </header>

    <CatalogSearch />

    <FilterPills categories={filterCategories} tags={filterTags} />

    <section class="catalog-section" aria-labelledby="catalog-heading">
      <h2 id="catalog-heading" class="catalog-section-title">
        Cheatsheets ({sorted.length})
      </h2>

      {sorted.length === 0 ? (
        <p class="catalog-empty">
          No cheatsheets yet. <a href={`${baseUrl}/about/`}>Contribute one</a>.
        </p>
      ) : (
        <ul class="catalog-list" role="list">
          {sorted.map((entry) => (
            <li
              class="catalog-list-item"
              data-category={entry.data.category}
              data-tags={entry.data.tags.join(' ')}
            >
              <CatalogCard
                href={cheatsheetHref(entry.slug)}
                title={entry.data.title}
                summary={entry.data.summary}
                category={entry.data.category}
                tags={entry.data.tags}
                lastUpdated={entry.data.last_updated}
                staleAfterDays={entry.data.stale_after_days}
              />
            </li>
          ))}
        </ul>
      )}
    </section>
  </main>
</Layout>

<style is:global>
  .catalog-main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.25rem 4rem;
  }

  .catalog-hero {
    margin-bottom: 3rem;
  }

  .catalog-hero-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 1rem 0;
    color: #111827;
  }

  .catalog-hero-lede {
    font-size: 1.125rem;
    line-height: 1.6;
    color: #4b5563;
    max-width: 60ch;
    margin: 0;
  }

  .catalog-hero-lede strong {
    color: #111827;
    font-weight: 600;
  }

  .catalog-section-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #111827;
    margin: 0 0 1.5rem 0;
  }

  .catalog-list {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
    grid-template-columns: 1fr;
  }

  /**
   * Honor the HTML `hidden` attribute when the catalog search toggles the
   * grid off — the explicit `display: grid` rule above otherwise wins over
   * the UA `[hidden] { display: none }` default. Same goes for the section
   * title and empty-state hint when a search query is active.
   */
  .catalog-list[hidden],
  .catalog-section-title[hidden],
  .catalog-empty[hidden] {
    display: none;
  }

  @media (min-width: 640px) {
    .catalog-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .catalog-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .catalog-list-item {
    display: flex;
  }

  .catalog-list-item > * {
    flex: 1;
  }

  .catalog-empty {
    color: #6b7280;
    font-size: 1rem;
  }

  .catalog-empty a {
    color: #2563eb;
    text-decoration: underline;
  }
</style>
