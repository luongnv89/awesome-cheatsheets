---
/**
 * Catalog / landing page.
 *
 * Lists every entry in the `cheatsheets` content collection with title,
 * one-liner summary, category, tags, and `last_updated`. Stale entries (per
 * `last_updated + stale_after_days`) get an inline "may be stale" badge in
 * the row. Statically rendered at build (Astro's default `output: 'static'`).
 *
 * The hero cites the project wedge — format + freshness + comparability — per
 * PRD §1. Internal links honor the configured base path (`/awesome-cheatsheets`).
 */
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CatalogCard from '../components/CatalogCard.astro';
import CatalogSearch from '../components/CatalogSearch.astro';
import FilterPills from '../components/FilterPills.astro';

const entries = await getCollection('cheatsheets', ({ data }) => {
  // Hide cheatsheets explicitly marked deprecated from the catalog; PoCs and
  // published entries both render. The schema defaults `status` to "published".
  return data.status !== 'deprecated';
});

// Sort newest first by last_updated (ISO-8601 strings sort lexicographically).
const sorted = [...entries].sort((a, b) =>
  b.data.last_updated.localeCompare(a.data.last_updated),
);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const cheatsheetHref = (slug: string) => `${baseUrl}/cheatsheets/${slug}/`;

// Unique facet sets for the filter pills (issue #22). Categories follow the
// schema enum order so the UI stays stable as the corpus grows; tags are
// emitted in alphabetical order for deterministic rendering and predictable
// e2e selectors. Both lists are derived from the visible corpus only — no
// pills for facets that have zero matching entries.
const CATEGORY_ORDER = ['tool', 'mcp', 'concept', 'comparison'] as const;
const categoriesInCorpus = new Set(sorted.map((e) => e.data.category));
const filterCategories = CATEGORY_ORDER.filter((c) => categoriesInCorpus.has(c));
const filterTags = Array.from(
  new Set(sorted.flatMap((e) => e.data.tags)),
).sort();
---

<Layout title="Awesome AI Cheatsheets">
  <main class="catalog-main">
    <header class="catalog-hero">
      <p class="catalog-hero-eyebrow" aria-hidden="true">Reference, refreshed.</p>
      <h1 class="catalog-hero-title">Awesome AI Cheatsheets</h1>
      <p class="catalog-hero-lede">
        Rich-format, visibly-dated, mutually-comparable references for terminal-native
        AI coding agents and the concepts behind them. Our wedge:
        <strong>format + freshness + comparability</strong> — every cheatsheet ships
        with a last-updated date and is flagged when it goes stale.
      </p>
      <div class="catalog-hero-pillars" role="list">
        <span class="catalog-hero-pillar" role="listitem">
          <span class="catalog-hero-pillar-dot" data-pillar="format"></span>
          Format
        </span>
        <span class="catalog-hero-pillar" role="listitem">
          <span class="catalog-hero-pillar-dot" data-pillar="freshness"></span>
          Freshness
        </span>
        <span class="catalog-hero-pillar" role="listitem">
          <span class="catalog-hero-pillar-dot" data-pillar="comparability"></span>
          Comparability
        </span>
      </div>
    </header>

    <CatalogSearch />

    <FilterPills categories={filterCategories} tags={filterTags} />

    <section class="catalog-section" aria-labelledby="catalog-heading">
      <h2 id="catalog-heading" class="catalog-section-title">
        Cheatsheets ({sorted.length})
      </h2>

      {sorted.length === 0 ? (
        <p class="catalog-empty">
          No cheatsheets yet. <a href={`${baseUrl}/about/`}>Contribute one</a>.
        </p>
      ) : (
        <ul class="catalog-list" role="list">
          {sorted.map((entry) => (
            <li
              class="catalog-list-item"
              data-category={entry.data.category}
              data-tags={entry.data.tags.join(' ')}
            >
              <CatalogCard
                href={cheatsheetHref(entry.slug)}
                title={entry.data.title}
                summary={entry.data.summary}
                category={entry.data.category}
                tags={entry.data.tags}
                lastUpdated={entry.data.last_updated}
                staleAfterDays={entry.data.stale_after_days}
              />
            </li>
          ))}
        </ul>
      )}
    </section>
  </main>
</Layout>

<style is:global>
  /*
   * Catalog hero typography lives in three files (index.astro, about.astro,
   * 404.astro) because Astro scopes `is:global` styles per route — keep these
   * blocks in sync. Brand-color tokens (--color-ink / --color-amber etc.)
   * come from Layout.astro's :root.
   */
  /*
   * Issue #86 — the catalog uses the full viewport width so the responsive
   * 1→2→3 column grid below can pack more cards into a single scroll view.
   * Header and footer keep their 1180px centered container in Layout.astro,
   * so only the card grid expands. Side padding scales with viewport: tight
   * on phones, generous on ultrawide so cards don't kiss the screen edge.
   */
  .catalog-main {
    margin: 0;
    padding: 3rem 1.25rem 4rem;
  }
  @media (min-width: 1024px) {
    .catalog-main {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }
  @media (min-width: 1600px) {
    .catalog-main {
      padding-left: 3rem;
      padding-right: 3rem;
    }
  }

  .catalog-hero {
    margin-bottom: 2.5rem;
    padding: 2.5rem 0 1.5rem;
    position: relative;
  }
  .catalog-hero::before {
    content: "";
    position: absolute;
    left: -2rem;
    top: 1.25rem;
    width: 6px;
    height: 3.5rem;
    background-color: var(--color-amber);
    border-radius: 4px;
    display: none;
  }
  @media (min-width: 1024px) {
    .catalog-hero::before { display: block; }
  }

  .catalog-hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-amber-deep);
    margin: 0 0 0.75rem;
  }

  .catalog-hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.05;
    margin: 0 0 1.25rem 0;
    color: var(--color-ink);
    letter-spacing: -0.015em;
  }

  .catalog-hero-lede {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 64ch;
    margin: 0;
  }

  .catalog-hero-lede strong {
    color: var(--color-ink);
    font-weight: 700;
  }

  .catalog-hero-pillars {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .catalog-hero-pillar {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    background-color: #fff;
    border: 1px solid var(--color-rule);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .catalog-hero-pillar-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }
  .catalog-hero-pillar-dot[data-pillar="format"]        { background-color: var(--color-ink); }
  .catalog-hero-pillar-dot[data-pillar="freshness"]     { background-color: var(--color-amber); }
  .catalog-hero-pillar-dot[data-pillar="comparability"] { background-color: var(--color-coral); }

  .catalog-section-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 1rem 0 1.5rem 0;
    letter-spacing: -0.01em;
  }

  .catalog-list {
    display: grid;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
    grid-template-columns: 1fr;
  }

  /*
   * Honor the HTML `hidden` attribute when the catalog search toggles the
   * grid off — the explicit `display: grid` rule above otherwise wins over
   * the UA `[hidden] { display: none }` default. Same goes for the section
   * title and empty-state hint when a search query is active.
   */
  .catalog-list[hidden],
  .catalog-section-title[hidden],
  .catalog-empty[hidden] {
    display: none;
  }

  @media (min-width: 640px) {
    .catalog-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .catalog-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .catalog-list-item {
    display: flex;
  }

  .catalog-list-item > * {
    flex: 1;
  }

  .catalog-empty {
    color: var(--color-muted);
    font-size: 1rem;
    padding: 2rem 1.5rem;
    background-color: #fff;
    border: 1px dashed var(--color-rule);
    border-radius: var(--radius-lg);
  }

  .catalog-empty a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-amber);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
</style>
