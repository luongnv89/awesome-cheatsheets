---
/**
 * Base layout — chrome shared by every non-cheatsheet page (catalog, about,
 * 404). Provides:
 *  - The new brand-aligned header (full.svg logo + nav: catalog, about) and
 *    footer (wordmark + repo link + license).
 *  - OG/Twitter meta tags pointing at the brand mark for social shares.
 *  - A system font stack — heading sans + body sans — kept off the network
 *    so the `no-cdn-check` CI gate stays green and Lighthouse perf doesn't
 *    regress.
 *
 * Cheatsheet detail pages use `CheatsheetLayout.astro` instead; both
 * layouts render the same `SiteHeader`/`SiteFooter` components and import
 * `src/styles/chrome.css`, so the header/footer markup and shared chrome
 * styles have a single source (issue #133, F-CLEAN-009).
 *
 * All internal links honor `import.meta.env.BASE_URL` (`/awesome-cheatsheets`
 * on GitHub Pages) via the precomputed `baseUrl` constant.
 */
import '../styles/base.css';
import '../styles/chrome.css';
import ConsentManager from '../components/ConsentManager.astro';
import SecurityHeaders from '../components/SecurityHeaders.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteOrigin = 'https://luongnv89.github.io';
const canonicalUrl = `${siteOrigin}${Astro.url.pathname}`;
const ogImage = `${siteOrigin}${baseUrl}/brand/mark.svg`;

const metaDescription =
  description ??
  'Rich-format, visibly-dated, mutually-comparable references for terminal-native AI coding agents and the concepts behind them.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#FAFAF7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0A1410" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        var theme = 'light';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            theme = 'dark';
          }
        } catch (e) { /* storage blocked — keep default */ }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <SecurityHeaders />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/brand/favicon.svg`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Awesome AI Cheatsheets" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <ConsentManager />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <SiteHeader />

    <div id="main-content">
      <slot />
    </div>

    <SiteFooter />
  </body>
</html>

<style is:global>
  /*
   * Layout-only base rules — the shared reset, tokens, typography,
   * skip-link, and site header/footer styles live in
   * `src/styles/chrome.css` (imported above). `body` here only sets the
   * line-height this layout uses (cheatsheet pages use 1.6 instead, see
   * `src/styles/cheatsheet.css`) and the page-column flex rule.
   */
  body {
    line-height: 1.55;
  }

  body > #main-content {
    flex: 1 0 auto;
  }
</style>
