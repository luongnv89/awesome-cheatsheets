---
/**
 * Base layout — chrome shared by every non-cheatsheet page (catalog, about,
 * 404). Provides:
 *  - The new brand-aligned header (full.svg logo + nav: catalog, about) and
 *    footer (wordmark + repo link + license).
 *  - OG/Twitter meta tags pointing at the brand mark for social shares.
 *  - A system font stack — heading sans + body sans — kept off the network
 *    so the `no-cdn-check` CI gate stays green and Lighthouse perf doesn't
 *    regress.
 *
 * Cheatsheet detail pages use `CheatsheetLayout.astro` instead; that layout
 * imports the same header/footer markup inline so chrome stays consistent.
 *
 * All internal links honor `import.meta.env.BASE_URL` (`/awesome-cheatsheets`
 * on GitHub Pages) via the precomputed `baseUrl` constant.
 */
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteOrigin = 'https://luongnv89.github.io';
const canonicalUrl = `${siteOrigin}${Astro.url.pathname}`;
const ogImage = `${siteOrigin}${baseUrl}/brand/mark.svg`;
const repoUrl = 'https://github.com/luongnv89/awesome-cheatsheets';

const metaDescription =
  description ??
  'Rich-format, visibly-dated, mutually-comparable references for terminal-native AI coding agents and the concepts behind them.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#0A1410" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/brand/favicon.svg`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Awesome AI Cheatsheets" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    {/* Google Analytics — gtag.js. `is:inline` keeps Astro from bundling
        the snippet so the global `gtag()` function is available to any
        page script that wants to send custom events. */}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-E82DZ04Y07"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-E82DZ04Y07');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header" role="banner">
      <div class="site-header-inner">
        <a class="site-brand" href={`${baseUrl}/`} aria-label="Awesome AI Cheatsheets — home">
          <img
            class="site-brand-logo"
            src={`${baseUrl}/brand/full.svg`}
            alt=""
            width="180"
            height="64"
            decoding="async"
          />
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a class="site-nav-link" href={`${baseUrl}/`}>Catalog</a>
          <a class="site-nav-link" href={`${baseUrl}/about/`}>About</a>
          <a class="site-nav-link site-nav-link-external" href={repoUrl} rel="noopener">
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <div id="main-content">
      <slot />
    </div>

    <footer class="site-footer" role="contentinfo">
      <div class="site-footer-inner">
        <a class="site-footer-brand" href={`${baseUrl}/`} aria-label="Awesome AI Cheatsheets — home">
          <img
            class="site-footer-logo"
            src={`${baseUrl}/brand/mark.svg`}
            alt=""
            width="40"
            height="40"
            decoding="async"
          />
          <span class="site-footer-name">Awesome AI Cheatsheets</span>
        </a>
        <p class="site-footer-meta">
          Code under MIT, content under CC-BY 4.0.
          <a href={repoUrl} rel="noopener">Source on GitHub</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /*
   * Global reset + brand typography. System font stack only — no CDN webfonts
   * (the `check:no-cdn` script blocks remote URLs in the built site). The
   * heading face is a transitional serif for distinction; the body face is
   * the standard sans-serif system stack. Pairing serif headings with sans
   * body lifts the visual identity above generic dev-tool blue.
   */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body, h1, h2, h3, h4, h5, h6, p, ul, ol, figure {
    margin: 0;
    padding: 0;
  }
  ul, ol {
    padding: 0;
  }

  :root {
    --color-ink: #0A1410;
    --color-ink-soft: #1A2E22;
    --color-amber: #39FF14;
    --color-amber-deep: #2BCC0F;
    --color-coral: #00C853;
    --color-coral-deep: #00A040;
    --color-paper: #F0FFF4;
    --color-paper-shade: #DCFCE7;
    --color-rule: #BBF7D0;
    --color-muted: #3A6B4E;
    --color-text: #0A1410;

    --font-heading: ui-serif, Georgia, 'Iowan Old Style', 'Apple Garamond', Cambria, 'Times New Roman', serif;
    --font-body: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

    --radius-sm: 0.375rem;
    --radius-md: 0.625rem;
    --radius-lg: 0.875rem;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    font-family: var(--font-body);
    line-height: 1.55;
    color: var(--color-text);
    background-color: var(--color-paper);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  body > #main-content {
    flex: 1 0 auto;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    color: var(--color-ink);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  a {
    color: var(--color-ink);
  }

  a:focus-visible {
    outline: 2px solid var(--color-coral);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  /* Skip-link — visible only when focused. Required for keyboard a11y. */
  .skip-link {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    transform: translateY(-150%);
    background: var(--color-ink);
    color: #fff;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.875rem;
    z-index: 100;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .skip-link:focus {
    transform: translateY(0);
  }

  /* Header */
  .site-header {
    background-color: var(--color-paper);
    border-bottom: 1px solid var(--color-rule);
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: saturate(180%) blur(6px);
    -webkit-backdrop-filter: saturate(180%) blur(6px);
    background-color: rgba(250, 247, 242, 0.9);
  }
  .site-header-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .site-brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--color-ink);
    border-radius: var(--radius-sm);
  }
  .site-brand-logo {
    height: 56px;
    width: auto;
    display: block;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: wrap;
  }
  .site-nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.875rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color 0.12s ease;
  }
  .site-nav-link:hover {
    background-color: var(--color-paper-shade);
  }
  .site-nav-link-external::after {
    content: "";
    display: inline-block;
    width: 0.6em;
    height: 0.6em;
    margin-left: 0.4em;
    border-top: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
    transform: translateY(-0.05em) rotate(45deg);
  }

  /* Footer */
  .site-footer {
    margin-top: 4rem;
    background-color: var(--color-ink);
    color: #DCFCE7;
    flex-shrink: 0;
  }
  .site-footer-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .site-footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: #fff;
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.125rem;
  }
  .site-footer-logo {
    width: 40px;
    height: 40px;
    display: block;
    border-radius: var(--radius-sm);
    background-color: #fff;
    padding: 4px;
  }
  .site-footer-name {
    color: #fff;
  }
  .site-footer-meta {
    font-size: 0.875rem;
    color: #BFBED1;
    margin: 0;
  }
  .site-footer-meta a {
    color: var(--color-amber);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .site-footer-meta a:hover {
    color: #FFCD3A;
  }
  .site-footer-meta a:focus-visible {
    outline-color: var(--color-amber);
  }

  @media (max-width: 480px) {
    .site-header-inner {
      padding: 0.625rem 1rem;
    }
    .site-brand-logo {
      height: 44px;
    }
    .site-nav-link {
      padding: 0.375rem 0.625rem;
      font-size: 0.875rem;
    }
    .site-footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      transition-duration: 0.001ms !important;
      animation-duration: 0.001ms !important;
    }
  }
</style>
