---
/**
 * Detail-page layout for content-collection entries (`src/pages/cheatsheets/
 * [slug]/index.astro`). Locked 7-section structure is owned by the markdown
 * body; this layout owns the chrome around it — header, footer, freshness
 * chip, stale banner, body typography.
 *
 * The `.freshness-chip`, `.absolute-date`, `.relative-date`, and
 * `.stale-banner` selectors are asserted by `e2e/freshness.test.ts`; the
 * stale-banner background+foreground combo is also contrast-tested. Anything
 * structural in those rules has to keep the same selectors and stay at
 * WCAG-AA contrast or higher.
 *
 * Header + footer markup mirrors `Layout.astro` so chrome stays cohesive
 * across catalog/about/404 and detail pages.
 */
interface Props {
  title: string;
  frontmatter: {
    title: string;
    summary: string;
    category: string;
    tags: string[];
    last_updated: string;
    stale_after_days: number;
  };
}

const { title, frontmatter } = Astro.props;

const today = new Date();
const lastUpdated = new Date(frontmatter.last_updated);
const hasValidDate = !isNaN(lastUpdated.getTime());
const daysSinceUpdate = hasValidDate
  ? Math.floor((today.getTime() - lastUpdated.getTime()) / (1000 * 60 * 60 * 24))
  : 0;
const isStale = hasValidDate && daysSinceUpdate > frontmatter.stale_after_days;

function getRelativeTime(days: number): string {
  if (days <= 0) return "today";
  if (days === 1) return "yesterday";
  if (days < 7) return `${days} days ago`;
  if (days < 14) return "1 week ago";
  if (days < 30) return `${Math.floor(days / 7)} weeks ago`;
  if (days < 60) return "1 month ago";
  return `${Math.floor(days / 30)} months ago`;
}

const relativeTime = getRelativeTime(daysSinceUpdate);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop() ?? '';

const siteOrigin = 'https://luongnv89.github.io';
const canonicalUrl = `${siteOrigin}${Astro.url.pathname}`;
const ogImage = `${siteOrigin}${baseUrl}/brand/mark.svg`;
const repoUrl = 'https://github.com/luongnv89/awesome-cheatsheets';
const metaDescription = frontmatter.summary;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#0A1410" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/brand/favicon.svg`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Awesome AI Cheatsheets" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header" role="banner">
      <div class="site-header-inner">
        <a class="site-brand" href={`${baseUrl}/`} aria-label="Awesome AI Cheatsheets — home">
          <img
            class="site-brand-logo"
            src={`${baseUrl}/brand/full.svg`}
            alt=""
            width="180"
            height="64"
            decoding="async"
          />
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a class="site-nav-link" href={`${baseUrl}/`}>Catalog</a>
          <a class="site-nav-link" href={`${baseUrl}/about/`}>About</a>
          <a class="site-nav-link site-nav-link-external" href={repoUrl} rel="noopener">
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="cheatsheet-main">
      <article
        class="cheatsheet"
        data-pagefind-body
        data-pagefind-meta={`title:${frontmatter.title}, category:${frontmatter.category}, last_updated:${frontmatter.last_updated}`}
      >
        {isStale && (
          <div class="stale-banner" role="alert">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <span>This cheatsheet may be stale (last updated {frontmatter.last_updated})</span>
          </div>
        )}

        <p class="cheatsheet-back">
          <a href={`${baseUrl}/`}>&larr; Back to catalog</a>
        </p>

        <header class="cheatsheet-header">
          <div class="cheatsheet-header-main">
            <span class={`catalog-category catalog-category-${frontmatter.category}`}>
              {frontmatter.category}
            </span>
            <h1 class="cheatsheet-title">{frontmatter.title}</h1>
            <p class="cheatsheet-summary">{frontmatter.summary}</p>
          </div>
          <aside class="cheatsheet-header-meta" aria-label="Document metadata">
            <div class="cheatsheet-header-meta-slug">{slug}</div>
            <div class="cheatsheet-header-meta-row">cheatsheet · {today.getFullYear()}</div>
            {hasValidDate && (
              <div class="freshness-chip" title={`Last updated: ${frontmatter.last_updated}`}>
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span class="absolute-date">{frontmatter.last_updated}</span>
                <span class="relative-date">({relativeTime})</span>
              </div>
            )}
          </aside>
          {frontmatter.tags.length > 0 && (
            <ul class="cheatsheet-tags" aria-label="tags">
              {frontmatter.tags.map((tag) => (
                <li class="cheatsheet-tag">{tag}</li>
              ))}
            </ul>
          )}
        </header>

        <div class="cheatsheet-content">
          <slot />
        </div>
      </article>
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="site-footer-inner">
        <a class="site-footer-brand" href={`${baseUrl}/`} aria-label="Awesome AI Cheatsheets — home">
          <img
            class="site-footer-logo"
            src={`${baseUrl}/brand/mark.svg`}
            alt=""
            width="40"
            height="40"
            decoding="async"
          />
          <span class="site-footer-name">Awesome AI Cheatsheets</span>
        </a>
        <p class="site-footer-meta">
          Code under MIT, content under CC-BY 4.0.
          <a href={repoUrl} rel="noopener">Source on GitHub</a>.
        </p>
      </div>
    </footer>

    {/*
     * Lazy mermaid renderer — only loads the (~3 MB) library when a cheatsheet
     * actually contains a <div class="mermaid"> emitted by remark-mermaid.ts.
     * Bundled from node_modules by Astro, so the no-cdn-check gate stays
     * green. `securityLevel: 'loose'` is required to allow inline `<br/>` in
     * node labels (the strict default strips them).
     */}
    <script>
      if (document.querySelector('.mermaid')) {
        const { default: mermaid } = await import('mermaid');
        mermaid.initialize({
          startOnLoad: false,
          theme: 'neutral',
          securityLevel: 'loose',
        });
        await mermaid.run({ querySelector: '.mermaid' });
      }
    </script>

    {/*
     * Step heading enhancer. Rewrites `### Step N — Title (qualifier)` H3s
     * into a pill badge ("STEP N") on its own row above the bare title, so
     * setup steps are visually distinct from regular H3s. The pattern only
     * matches the literal `Step <digits>` prefix; other H3s are left alone.
     */}
    <script>
      const stepHeadings = document.querySelectorAll('.cheatsheet-content h3');
      const STEP_RE = /^Step\s+(\d+)\s*[—–-]\s*(.+)$/;
      stepHeadings.forEach((h3) => {
        const match = h3.textContent?.trim().match(STEP_RE);
        if (!match) return;
        const [, n, title] = match;
        h3.classList.add('step-heading');
        h3.innerHTML = '';
        const badge = document.createElement('span');
        badge.className = 'step-badge';
        badge.textContent = `STEP ${n}`;
        const titleEl = document.createElement('span');
        titleEl.className = 'step-title';
        titleEl.textContent = title ?? '';
        h3.appendChild(badge);
        h3.appendChild(titleEl);
      });
    </script>

    {/*
     * Copy buttons on every fenced code block. Wraps each <pre> in a
     * positioned container and injects a button that copies the code text and
     * flips to "Copied" for 1.5s. Skips Mermaid wrappers (handled separately).
     */}
    <script>
      const RESET_MS = 1500;
      const blocks = document.querySelectorAll('.cheatsheet-content pre');
      blocks.forEach((pre) => {
        if (pre.closest('.mermaid')) return;
        if (pre.parentElement?.classList.contains('code-block')) return;

        const wrapper = document.createElement('div');
        wrapper.className = 'code-block';
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'code-block-copy';
        button.setAttribute('aria-label', 'Copy code to clipboard');
        button.textContent = 'Copy';
        wrapper.appendChild(button);

        button.addEventListener('click', async () => {
          const code = pre.querySelector('code');
          const text = (code?.innerText ?? pre.innerText).replace(/\n$/, '');
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = 'Copied';
            button.classList.add('is-copied');
          } catch {
            button.textContent = 'Failed';
            button.classList.add('is-failed');
          }
          setTimeout(() => {
            button.textContent = 'Copy';
            button.classList.remove('is-copied', 'is-failed');
          }, RESET_MS);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body, h1, h2, h3, h4, h5, h6, p, ul, ol, figure {
    margin: 0;
    padding: 0;
  }
  ul, ol {
    padding: 0;
  }

  :root {
    --color-ink: #0A1410;
    --color-ink-soft: #1A2E22;
    --color-amber: #39FF14;
    --color-amber-deep: #2BCC0F;
    --color-coral: #00C853;
    --color-coral-deep: #00A040;
    --color-paper: #F0FFF4;
    --color-paper-shade: #DCFCE7;
    --color-rule: #BBF7D0;
    --color-muted: #3A6B4E;
    --color-text: #0A1410;

    --font-heading: ui-serif, Georgia, 'Iowan Old Style', 'Apple Garamond', Cambria, 'Times New Roman', serif;
    --font-body: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

    --radius-sm: 0.375rem;
    --radius-md: 0.625rem;
    --radius-lg: 0.875rem;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    font-family: var(--font-body);
    line-height: 1.6;
    color: var(--color-text);
    background-color: var(--color-paper);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    color: var(--color-ink);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  a {
    color: var(--color-ink);
  }
  a:focus-visible {
    outline: 2px solid var(--color-coral);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .skip-link {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    transform: translateY(-150%);
    background: var(--color-ink);
    color: #fff;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.875rem;
    z-index: 100;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .skip-link:focus { transform: translateY(0); }

  /* Header (mirrors Layout.astro) */
  .site-header {
    border-bottom: 1px solid var(--color-rule);
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: rgba(250, 247, 242, 0.9);
    backdrop-filter: saturate(180%) blur(6px);
    -webkit-backdrop-filter: saturate(180%) blur(6px);
  }
  .site-header-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .site-brand { display: inline-flex; align-items: center; text-decoration: none; color: var(--color-ink); border-radius: var(--radius-sm); }
  .site-brand-logo { height: 56px; width: auto; display: block; }
  .site-nav { display: flex; align-items: center; gap: 0.25rem; flex-wrap: wrap; }
  .site-nav-link {
    display: inline-flex; align-items: center;
    padding: 0.5rem 0.875rem;
    font-size: 0.9375rem; font-weight: 500;
    color: var(--color-ink); text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color 0.12s ease;
  }
  .site-nav-link:hover { background-color: var(--color-paper-shade); }
  .site-nav-link-external::after {
    content: ""; display: inline-block;
    width: 0.6em; height: 0.6em; margin-left: 0.4em;
    border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor;
    transform: translateY(-0.05em) rotate(45deg);
  }

  /* Footer (mirrors Layout.astro) */
  .site-footer {
    margin-top: 4rem;
    background-color: var(--color-ink);
    color: #DCFCE7;
    flex-shrink: 0;
  }
  .site-footer-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .site-footer-brand {
    display: inline-flex; align-items: center; gap: 0.75rem;
    color: #fff; text-decoration: none;
    font-family: var(--font-heading); font-weight: 700; font-size: 1.125rem;
  }
  .site-footer-logo {
    width: 40px; height: 40px; display: block;
    border-radius: var(--radius-sm); background-color: #fff; padding: 4px;
  }
  .site-footer-name { color: #fff; }
  .site-footer-meta { font-size: 0.875rem; color: #BFBED1; margin: 0; }
  .site-footer-meta a {
    color: var(--color-amber); text-decoration: underline;
    text-decoration-thickness: 1px; text-underline-offset: 2px;
  }
  .site-footer-meta a:hover { color: #FFCD3A; }
  .site-footer-meta a:focus-visible { outline-color: var(--color-amber); }

  @media (max-width: 480px) {
    .site-header-inner { padding: 0.625rem 1rem; }
    .site-brand-logo { height: 44px; }
    .site-nav-link { padding: 0.375rem 0.625rem; font-size: 0.875rem; }
    .site-footer-inner { flex-direction: column; align-items: flex-start; gap: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      transition-duration: 0.001ms !important;
      animation-duration: 0.001ms !important;
    }
  }

  /* ----- Cheatsheet page ----- */
  .cheatsheet-main {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.25rem 3rem;
    flex: 1 0 auto;
  }
  .cheatsheet-back {
    margin: 0 0 1rem 0;
    font-size: 0.9375rem;
  }
  .cheatsheet-back a {
    color: var(--color-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.12s ease, border-color 0.12s ease;
  }
  .cheatsheet-back a:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-amber);
  }

  /* MAG-style header strip: title + summary on the left, meta column on
     the right, anchored by a neon-green underline. */
  .cheatsheet-header {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "main meta"
      "tags tags";
    align-items: end;
    gap: 0.75rem 2rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 3px solid var(--color-amber);
  }
  .cheatsheet-header-main { grid-area: main; min-width: 0; }
  .cheatsheet-header-meta {
    grid-area: meta;
    text-align: right;
    font-size: 0.8125rem;
    color: var(--color-muted);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.375rem;
    line-height: 1.4;
  }
  .cheatsheet-header-meta-slug {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-ink);
    font-size: 0.875rem;
  }
  .cheatsheet-header-meta-row { color: var(--color-muted); }

  .cheatsheet-title {
    font-size: clamp(1.625rem, 3vw, 2.125rem);
    font-weight: 700;
    margin: 0.5rem 0 0.5rem;
    color: var(--color-ink);
    letter-spacing: -0.015em;
  }

  .cheatsheet-summary {
    font-size: 1rem;
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0;
    max-width: 65ch;
  }

  .cheatsheet-tags {
    grid-area: tags;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0.25rem 0 0;
  }
  .cheatsheet-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    background-color: var(--color-paper-shade);
    color: var(--color-ink);
    font-size: 0.75rem;
    font-family: var(--font-mono);
  }

  /* Category badges — shared with CatalogCard.astro for visual continuity.
     Tone is muted on paper so the cheatsheet title stays the focal point. */
  .catalog-category {
    display: inline-flex;
    align-items: center;
    padding: 0.1875rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: capitalize;
    border: 1px solid transparent;
    letter-spacing: 0.02em;
  }
  .catalog-category-tool       { background-color: #FFF4CC; color: #6F5300; border-color: #F2DD8A; }
  .catalog-category-mcp        { background-color: #E6E1FF; color: #2E2280; border-color: #C2B7F2; }
  .catalog-category-concept    { background-color: #D9F3DE; color: #1B5B2B; border-color: #A8DAB1; }
  .catalog-category-comparison { background-color: #FFE3DF; color: #8A2A1F; border-color: #F2A99F; }

  /* Stale banner — kept at WCAG-AA contrast (asserted in
     e2e/freshness.test.ts). #fef3c7 background + #92400e foreground gives
     ~9:1 contrast; values left identical to the prior version. */
  .stale-banner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    margin-bottom: 1.5rem;
    background-color: #fef3c7;
    border: 1px solid #fcd34d;
    border-radius: var(--radius-md);
    color: #92400e;
    font-weight: 500;
  }
  .stale-banner svg {
    flex-shrink: 0;
    color: #d97706;
  }

  /* Freshness chip — selectors and contrast asserted by
     e2e/freshness.test.ts. .absolute-date and .relative-date are read by the
     tests; keep both. */
  .freshness-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.625rem;
    background-color: var(--color-paper-shade);
    border: 1px solid var(--color-rule);
    border-radius: 9999px;
    font-size: 0.75rem;
    color: var(--color-ink);
  }
  .freshness-chip svg { color: var(--color-muted); }
  .absolute-date {
    font-weight: 600;
    color: var(--color-ink);
    font-family: var(--font-mono);
  }
  .relative-date {
    /* On --color-paper-shade (#DCFCE7), --color-muted (#3A6B4E) gives ~6:1
       contrast — comfortably above WCAG AA (4.5). */
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .cheatsheet-main { padding: 1.5rem 1rem 2rem; }
    .cheatsheet-header {
      grid-template-columns: 1fr;
      grid-template-areas: "main" "meta" "tags";
    }
    .cheatsheet-header-meta { text-align: left; align-items: flex-start; }
  }
</style>
