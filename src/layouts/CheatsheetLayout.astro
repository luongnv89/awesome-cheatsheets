---
/**
 * Detail-page layout for content-collection entries (`src/pages/cheatsheets/
 * [slug]/index.astro`). Locked 7-section structure is owned by the markdown
 * body; this layout owns the chrome around it — header, footer, freshness
 * chip, stale banner, body typography.
 *
 * The `.freshness-chip`, `.absolute-date`, `.relative-date`, and
 * `.stale-banner` selectors are asserted by `e2e/freshness.test.ts`; the
 * stale-banner background+foreground combo is also contrast-tested. Anything
 * structural in those rules has to keep the same selectors and stay at
 * WCAG-AA contrast or higher.
 *
 * Header + footer markup mirrors `Layout.astro` so chrome stays cohesive
 * across catalog/about/404 and detail pages.
 */
import ConsentManager from '../components/ConsentManager.astro';
import ShareButtons from '../components/ShareButtons.astro';

interface Props {
  title: string;
  frontmatter: {
    title: string;
    summary: string;
    category: string;
    tags: string[];
    last_updated: string;
    stale_after_days: number;
  };
  /**
   * When true, the article is rendered without Pagefind's `data-pagefind-body`
   * marker so the page is excluded from the search index (issue #90). The
   * page itself still renders at the canonical URL — reviewers can read
   * drafts by direct link, but they never appear in `/`'s search results.
   */
  isDraft?: boolean;
}

const { title, frontmatter, isDraft = false } = Astro.props;

const today = new Date();
const lastUpdated = new Date(frontmatter.last_updated);
const hasValidDate = !isNaN(lastUpdated.getTime());
const daysSinceUpdate = hasValidDate
  ? Math.floor((today.getTime() - lastUpdated.getTime()) / (1000 * 60 * 60 * 24))
  : 0;
const isStale = hasValidDate && daysSinceUpdate > frontmatter.stale_after_days;

function getRelativeTime(days: number): string {
  if (days <= 0) return "today";
  if (days === 1) return "yesterday";
  if (days < 7) return `${days} days ago`;
  if (days < 14) return "1 week ago";
  if (days < 30) return `${Math.floor(days / 7)} weeks ago`;
  if (days < 60) return "1 month ago";
  return `${Math.floor(days / 30)} months ago`;
}

const relativeTime = getRelativeTime(daysSinceUpdate);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop() ?? '';

const siteOrigin = 'https://luongnv89.github.io';
const canonicalUrl = `${siteOrigin}${Astro.url.pathname}`;
const ogImage = `${siteOrigin}${baseUrl}/brand/mark.svg`;
const repoUrl = 'https://github.com/luongnv89/awesome-cheatsheets';
const metaDescription = frontmatter.summary;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#0A1410" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/brand/favicon.svg`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Awesome AI Cheatsheets" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <ConsentManager />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header" role="banner">
      <div class="site-header-inner">
        <a class="site-brand" href={`${baseUrl}/`} aria-label="Awesome AI Cheatsheets — home">
          <img
            class="site-brand-logo"
            src={`${baseUrl}/brand/full.svg`}
            alt=""
            width="180"
            height="64"
            decoding="async"
          />
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a class="site-nav-link" href={`${baseUrl}/`}>Catalog</a>
          <a class="site-nav-link" href={`${baseUrl}/about/`}>About</a>
          <a class="site-nav-link site-nav-link-external" href={repoUrl} rel="noopener">
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="cheatsheet-main">
      <article
        class="cheatsheet"
        data-pagefind-body={isDraft ? undefined : true}
        data-pagefind-meta={isDraft
          ? undefined
          : `title:${frontmatter.title}, category:${frontmatter.category}, last_updated:${frontmatter.last_updated}`}
      >
        {isStale && (
          <div class="stale-banner" role="alert">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <span>This cheatsheet may be stale (last updated {frontmatter.last_updated})</span>
          </div>
        )}

        <p class="cheatsheet-back">
          <a href={`${baseUrl}/`}>&larr; Back to catalog</a>
        </p>

        {/*
         * Sentinel + sticky header band.
         *
         * Issue #91 — the cheatsheet title must stay pinned at the top of
         * the viewport once the user scrolls past the full in-flow header.
         * We render the title twice (full + compact-sticky) — but only the
         * compact band is `position: sticky`, and it stays
         * `aria-hidden`/visually hidden until the IntersectionObserver
         * watching `.cheatsheet-header-sentinel` reports the full header
         * has scrolled out. This avoids any double-up at the top of the
         * page and keeps the compact band a single, dedicated DOM node
         * (no jank from animating an already-large header to compact).
         */}
        <div class="cheatsheet-header-sentinel" aria-hidden="true"></div>

        <header class="cheatsheet-header">
          <div class="cheatsheet-header-main">
            <span class={`catalog-category catalog-category-${frontmatter.category}`}>
              {frontmatter.category}
            </span>
            <h1 class="cheatsheet-title">{frontmatter.title}</h1>
            <p class="cheatsheet-summary">{frontmatter.summary}</p>
          </div>
          <aside class="cheatsheet-header-meta" aria-label="Document metadata">
            <div class="cheatsheet-header-meta-slug">{slug}</div>
            <div class="cheatsheet-header-meta-row">cheatsheet · {today.getFullYear()}</div>
            {hasValidDate && (
              <div class="freshness-chip" title={`Last updated: ${frontmatter.last_updated}`}>
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span class="absolute-date">{frontmatter.last_updated}</span>
                <span class="relative-date">({relativeTime})</span>
              </div>
            )}
          </aside>
          {frontmatter.tags.length > 0 && (
            <ul class="cheatsheet-tags" aria-label="tags">
              {frontmatter.tags.map((tag) => (
                <li class="cheatsheet-tag">{tag}</li>
              ))}
            </ul>
          )}
          <div class="share-buttons-row">
            <ShareButtons title={frontmatter.title} url={canonicalUrl} />
          </div>
        </header>

        {/*
         * Sticky compact title band — issue #91.
         *
         * Sits below the site header (`top: var(--site-header-h)`) so the
         * two sticky bars stack cleanly instead of fighting. The band is
         * invisible (visually hidden, aria-hidden, pointer-events:none)
         * until the IntersectionObserver on `.cheatsheet-header-sentinel`
         * flips `.is-active` on, at which point it slides into view.
         *
         * On wide viewports the band also carries an inline section
         * indicator on the right ("Section: <name>") synced to the
         * currently-visible h2 — a low-noise way to tell the reader where
         * they are in the article when the TOC aside is scrolled out.
         */}
        <div class="cheatsheet-sticky-header" aria-hidden="true">
          <div class="cheatsheet-sticky-header-inner">
            <span class={`catalog-category catalog-category-${frontmatter.category}`}>
              {frontmatter.category}
            </span>
            <h2 class="cheatsheet-sticky-title">{frontmatter.title}</h2>
            <span class="cheatsheet-sticky-section" data-section-indicator></span>
          </div>
        </div>

        <div class="cheatsheet-content" data-slug={slug}>
          {/*
           * TOC aside — issue #92.
           *
           * Built client-side from the h2 headings in `.cheatsheet-body`
           * after the markdown content renders. Sits in the grid gutter at
           * ≥1024px and stays sticky alongside the reading column; on
           * narrow viewports the aside is removed from layout (CSS
           * `display: none` until 1024px) so the body has the full width.
           *
           * The script populates the <ol> on mount, or sets `hidden` on
           * the aside if the page has fewer than two h2s (a TOC of one
           * item is noise, not navigation). Rendered WITHOUT `hidden`
           * by default so the grid claim its 2-column shape on first
           * paint — avoids a CLS jump when JS finishes building the list.
           */}
          <aside class="cheatsheet-toc" aria-label="On this page">
            <p class="cheatsheet-toc-title">On this page</p>
            <ol class="cheatsheet-toc-list"></ol>
          </aside>
          <slot />
        </div>
      </article>
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="site-footer-inner">
        <a class="site-footer-brand" href={`${baseUrl}/`} aria-label="Awesome AI Cheatsheets — home">
          <img
            class="site-footer-logo"
            src={`${baseUrl}/brand/mark.svg`}
            alt=""
            width="40"
            height="40"
            decoding="async"
          />
          <span class="site-footer-name">Awesome AI Cheatsheets</span>
        </a>
        <p class="site-footer-meta">
          Code under MIT, content under CC-BY 4.0.
          <a href={repoUrl} rel="noopener">Source on GitHub</a> ·
          <button type="button" class="site-footer-link-button" onclick="window.__consent?.reopen()">
            Cookie preferences
          </button>.
        </p>
      </div>
    </footer>

    {/*
     * Lazy mermaid renderer — only loads the (~3 MB) library when a cheatsheet
     * actually contains a <div class="mermaid"> emitted by remark-mermaid.ts.
     * Bundled from node_modules by Astro, so the no-cdn-check gate stays
     * green. `securityLevel: 'loose'` is required to allow inline `<br/>` in
     * node labels (the strict default strips them).
     */}
    <script>
      if (document.querySelector('.mermaid')) {
        const { default: mermaid } = await import('mermaid');
        mermaid.initialize({
          startOnLoad: false,
          theme: 'neutral',
          securityLevel: 'loose',
        });
        await mermaid.run({ querySelector: '.mermaid' });
      }
    </script>

    {/*
     * Step heading enhancer. Rewrites `### Step N — Title (qualifier)` H3s
     * into a checkbox + pill badge ("STEP N") + bare title, so setup steps
     * are visually distinct from regular H3s. The pattern only matches the
     * literal `Step <digits>` prefix; other H3s are left alone.
     *
     * Checkbox state persists per-cheatsheet via localStorage. Checking a
     * step strikes through its title and all sibling nodes up to (but not
     * including) the next Step H3 or the next H2 — i.e., the visual span
     * the user just completed.
     */}
    <script>
      const container = document.querySelector('.cheatsheet-content');
      if (container) {
        const slug = container.getAttribute('data-slug') ?? 'unknown';
        const storageKey = `cheatsheet-progress:${slug}`;
        /** @type {Record<string, boolean>} */
        let state = {};
        try {
          state = JSON.parse(localStorage.getItem(storageKey) ?? '{}') ?? {};
        } catch {
          state = {};
        }
        const persist = () => {
          try {
            localStorage.setItem(storageKey, JSON.stringify(state));
          } catch {
            /* storage disabled — silent no-op */
          }
        };

        const STEP_RE = /^Step\s+(\d+)\s*[—–-]\s*(.+)$/;
        const stepHeadings = container.querySelectorAll('h3');

        /**
         * Collect the sibling element nodes that belong to a Step heading:
         * everything between this H3 and the next Step H3 / any H2.
         * @param {Element} h3
         */
        const collectBody = (h3) => {
          /** @type {Element[]} */
          const nodes = [];
          let sib = h3.nextElementSibling;
          while (sib) {
            if (sib.tagName === 'H2') break;
            if (sib.tagName === 'H3' && STEP_RE.test(sib.textContent?.trim() ?? '')) break;
            nodes.push(sib);
            sib = sib.nextElementSibling;
          }
          return nodes;
        };

        /** @type {string[]} */
        const stepKeys = [];
        /** @type {Element | null} */
        let sectionH2 = null;

        stepHeadings.forEach((h3) => {
          const match = h3.textContent?.trim().match(STEP_RE);
          if (!match) return;
          const [, n, title] = match;
          const stepKey = `step-${n}`;
          stepKeys.push(stepKey);

          if (!sectionH2) {
            let prev = h3.previousElementSibling;
            while (prev) {
              if (prev.tagName === 'H2') {
                sectionH2 = prev;
                break;
              }
              prev = prev.previousElementSibling;
            }
          }

          h3.classList.add('step-heading');
          h3.innerHTML = '';

          const checkbox = document.createElement('input');
          checkbox.type = 'checkbox';
          checkbox.className = 'step-checkbox';
          checkbox.setAttribute('aria-label', `Mark Step ${n} done`);
          checkbox.checked = state[stepKey] === true;

          const badge = document.createElement('span');
          badge.className = 'step-badge';
          badge.textContent = `STEP ${n}`;

          const titleEl = document.createElement('span');
          titleEl.className = 'step-title';
          titleEl.textContent = title ?? '';

          h3.appendChild(checkbox);
          h3.appendChild(badge);
          h3.appendChild(titleEl);

          const body = collectBody(h3);
          const applyDone = (done) => {
            h3.classList.toggle('is-done', done);
            for (const node of body) node.classList.toggle('step-done-body', done);
          };
          applyDone(checkbox.checked);

          checkbox.addEventListener('change', () => {
            state[stepKey] = checkbox.checked;
            persist();
            applyDone(checkbox.checked);
            updateProgress();
          });
        });

        /** @type {HTMLElement | null} */
        let progressChip = null;
        if (sectionH2 && stepKeys.length > 0) {
          progressChip = document.createElement('span');
          progressChip.className = 'step-progress';
          progressChip.setAttribute('aria-live', 'polite');
          sectionH2.appendChild(progressChip);
        }

        function updateProgress() {
          if (!progressChip) return;
          const done = stepKeys.filter((k) => state[k] === true).length;
          const total = stepKeys.length;
          progressChip.textContent = `${done} / ${total} done`;
          progressChip.classList.toggle('is-complete', done === total && total > 0);
        }
        updateProgress();
      }
    </script>

    {/*
     * Table of contents + sticky-header coordinator — issues #91 and #92.
     *
     * - Builds a TOC from h2 headings in `.cheatsheet-body` and inserts it
     *   into the `.cheatsheet-toc` aside. If the article has fewer than two
     *   h2s the aside is left hidden (a single-item TOC is noise).
     *
     * - Watches `.cheatsheet-header-sentinel` with IntersectionObserver to
     *   toggle `.cheatsheet-sticky-header.is-active` once the in-flow
     *   header has scrolled out. No scroll listener — IntersectionObserver
     *   is the right tool here: it fires only on threshold crossings, so
     *   the band can't flicker mid-scroll.
     *
     * - Watches each h2 with a second IntersectionObserver to:
     *     a) highlight the current section in the TOC,
     *     b) populate the inline section indicator in the sticky band.
     *
     * Reduced motion is respected via CSS (no transitions if the user has
     * `prefers-reduced-motion: reduce`).
     */}
    <script>
      const body = document.querySelector('.cheatsheet-body');
      const tocAside = document.querySelector('.cheatsheet-toc');
      const tocList = tocAside?.querySelector('.cheatsheet-toc-list');
      const stickyHeader = document.querySelector('.cheatsheet-sticky-header');
      const sentinel = document.querySelector('.cheatsheet-header-sentinel');
      const sectionIndicator = document.querySelector('[data-section-indicator]');

      // -- TOC build --------------------------------------------------------
      /** @type {HTMLHeadingElement[]} */
      const h2s = body
        ? Array.from(body.querySelectorAll(':scope > h2'))
        : [];

      if (tocAside && tocList) {
        if (h2s.length >= 2) {
          for (const h2 of h2s) {
            if (!h2.id) continue;
            const text = (h2.textContent ?? '').replace(/\s*\d+\s*\/\s*\d+\s*done\s*$/i, '').trim();
            if (!text) continue;
            const li = document.createElement('li');
            li.className = 'cheatsheet-toc-item';
            const a = document.createElement('a');
            a.href = `#${h2.id}`;
            a.className = 'cheatsheet-toc-link';
            a.textContent = text;
            a.dataset.tocTarget = h2.id;
            li.appendChild(a);
            tocList.appendChild(li);
          }
        }
        // Hide the aside if we ended up with <2 entries — keeps the grid
        // collapsed to a single column via `:has(.cheatsheet-toc[hidden])`
        // when there's nothing useful to show.
        if (tocList.children.length < 2) {
          tocAside.setAttribute('hidden', '');
        }
      }

      // -- Sticky-header toggle (issue #91) --------------------------------
      if (stickyHeader && sentinel) {
        const stickyObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              // Sentinel sits where the full header used to be. When it
              // leaves the top of the viewport (intersectionRatio drops to
              // 0 while boundingClientRect.top < 0), the compact band
              // takes over.
              const rect = entry.boundingClientRect;
              const active = !entry.isIntersecting && rect.top < 0;
              stickyHeader.classList.toggle('is-active', active);
              stickyHeader.setAttribute('aria-hidden', active ? 'false' : 'true');
            }
          },
          { rootMargin: '0px', threshold: [0, 1] },
        );
        stickyObserver.observe(sentinel);
      }

      // -- Section indicator + TOC active-link (issue #92) ------------------
      if (h2s.length > 0) {
        /** @type {Map<string, HTMLAnchorElement | null>} */
        const linkByTarget = new Map();
        if (tocList) {
          for (const a of tocList.querySelectorAll('a.cheatsheet-toc-link')) {
            linkByTarget.set(a.dataset.tocTarget ?? '', a);
          }
        }

        /** @type {Set<Element>} */
        const visible = new Set();
        const setCurrent = () => {
          // Pick the topmost visible h2 — that's the section the reader is
          // currently in. If none are visible (between sections), fall back
          // to the last one we saw above the fold.
          let current = null;
          for (const h2 of h2s) {
            const rect = h2.getBoundingClientRect();
            if (rect.top <= window.innerHeight * 0.35) current = h2;
            else break;
          }
          for (const a of linkByTarget.values()) {
            if (a) a.classList.remove('is-current');
          }
          if (current) {
            const text = (current.textContent ?? '').replace(/\s*\d+\s*\/\s*\d+\s*done\s*$/i, '').trim();
            if (sectionIndicator) sectionIndicator.textContent = text;
            const link = linkByTarget.get(current.id);
            if (link) link.classList.add('is-current');
          } else if (sectionIndicator) {
            sectionIndicator.textContent = '';
          }
        };

        const sectionObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) visible.add(entry.target);
              else visible.delete(entry.target);
            }
            setCurrent();
          },
          { rootMargin: '-15% 0px -50% 0px', threshold: 0 },
        );
        for (const h2 of h2s) sectionObserver.observe(h2);
        setCurrent();
      }
    </script>

    {/*
     * Copy buttons on every fenced code block. Wraps each <pre> in a
     * positioned container and injects a button that copies the code text and
     * flips to "Copied" for 1.5s. Skips Mermaid wrappers (handled separately).
     */}
    <script>
      const RESET_MS = 1500;
      const blocks = document.querySelectorAll('.cheatsheet-content pre');
      blocks.forEach((pre) => {
        if (pre.closest('.mermaid')) return;
        if (pre.parentElement?.classList.contains('code-block')) return;

        const wrapper = document.createElement('div');
        wrapper.className = 'code-block';
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'code-block-copy';
        button.setAttribute('aria-label', 'Copy code to clipboard');
        button.textContent = 'Copy';
        wrapper.appendChild(button);

        button.addEventListener('click', async () => {
          const code = pre.querySelector('code');
          const text = (code?.innerText ?? pre.innerText).replace(/\n$/, '');
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = 'Copied';
            button.classList.add('is-copied');
          } catch {
            button.textContent = 'Failed';
            button.classList.add('is-failed');
          }
          setTimeout(() => {
            button.textContent = 'Copy';
            button.classList.remove('is-copied', 'is-failed');
          }, RESET_MS);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body, h1, h2, h3, h4, h5, h6, p, ul, ol, figure {
    margin: 0;
    padding: 0;
  }
  ul, ol {
    padding: 0;
  }

  :root {
    --color-ink: #0A1410;
    --color-ink-soft: #1A2E22;
    --color-amber: #39FF14;
    --color-amber-deep: #2BCC0F;
    --color-coral: #00C853;
    --color-coral-deep: #00A040;
    --color-paper: #F0FFF4;
    --color-paper-shade: #DCFCE7;
    --color-rule: #BBF7D0;
    --color-muted: #3A6B4E;
    --color-text: #0A1410;

    --font-heading: ui-serif, Georgia, 'Iowan Old Style', 'Apple Garamond', Cambria, 'Times New Roman', serif;
    --font-body: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

    --radius-sm: 0.375rem;
    --radius-md: 0.625rem;
    --radius-lg: 0.875rem;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    font-family: var(--font-body);
    line-height: 1.6;
    color: var(--color-text);
    background-color: var(--color-paper);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    color: var(--color-ink);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  a {
    color: var(--color-ink);
  }
  a:focus-visible {
    outline: 2px solid var(--color-coral);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .skip-link {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    transform: translateY(-150%);
    background: var(--color-ink);
    color: #fff;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.875rem;
    z-index: 100;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
