---
/**
 * Detail-page layout for content-collection entries (`src/pages/cheatsheets/
 * [slug]/index.astro`). Locked 7-section structure is owned by the markdown
 * body; this layout owns the chrome around it — header, footer, freshness
 * chip, stale banner, body typography.
 *
 * The `.freshness-chip`, `.absolute-date`, `.relative-date`, and
 * `.stale-banner` selectors are asserted by `e2e/freshness.test.ts`; the
 * stale-banner background+foreground combo is also contrast-tested. Anything
 * structural in those rules has to keep the same selectors and stay at
 * WCAG-AA contrast or higher.
 *
 * Chrome is split out of this file (issue #133, F-CLEAN-005/F-CLEAN-009):
 *  - `SiteHeader.astro` / `SiteFooter.astro` own the header/footer markup
 *    shared with `Layout.astro`.
 *  - `src/styles/chrome.css` owns the shared reset/tokens/header/footer
 *    rules; `src/styles/cheatsheet.css` owns the cheatsheet-only styles.
 *  - `src/components/cheatsheet/` owns the client-side enhancement scripts
 *    (mermaid, step checklist, TOC + sticky header, code-copy buttons).
 */
import '../styles/base.css';
import '../styles/chrome.css';
import '../styles/cheatsheet.css';
import ConsentManager from '../components/ConsentManager.astro';
import SecurityHeaders from '../components/SecurityHeaders.astro';
import ShareButtons from '../components/ShareButtons.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MermaidLoader from '../components/cheatsheet/MermaidLoader.astro';
import StepChecklist from '../components/cheatsheet/StepChecklist.astro';
import StickyToc from '../components/cheatsheet/StickyToc.astro';
import CodeCopyButtons from '../components/cheatsheet/CodeCopyButtons.astro';
import ContentEnhance from '../components/cheatsheet/ContentEnhance.astro';
// Staleness rule lives in `tools/utils/freshness.ts` — the single source of
// truth shared with CatalogCard.astro and the freshness CI (issue #135).
import { daysSinceUpdate, isStale } from '../../tools/utils/freshness.js';

interface Props {
  title: string;
  frontmatter: {
    title: string;
    summary: string;
    category: string;
    tags: string[];
    last_updated: string;
    stale_after_days: number;
    upstream_version?: string;
  };
  /** Number of `### Step N — …` headings in the body (0 hides step UI). */
  stepCount?: number;
  /** Total estimated minutes summed from `**Time:**` step meta. */
  stepMinutes?: number;
  /**
   * When true, the article is rendered without Pagefind's `data-pagefind-body`
   * marker so the page is excluded from the search index (issue #90). The
   * page itself still renders at the canonical URL — reviewers can read
   * drafts by direct link, but they never appear in `/`'s search results.
   */
  isDraft?: boolean;
}

const {
  title,
  frontmatter,
  stepCount = 0,
  stepMinutes = 0,
  isDraft = false,
} = Astro.props;

const today = new Date();
const days = daysSinceUpdate(frontmatter.last_updated, today);
const hasValidDate = days !== null;
const daysCount = days ?? 0;
const stale = isStale(frontmatter.last_updated, frontmatter.stale_after_days, today);

function getRelativeTime(days: number): string {
  if (days <= 0) return "today";
  if (days === 1) return "yesterday";
  if (days < 7) return `${days} days ago`;
  if (days < 14) return "1 week ago";
  if (days < 30) return `${Math.floor(days / 7)} weeks ago`;
  if (days < 60) return "1 month ago";
  return `${Math.floor(days / 30)} months ago`;
}

const relativeTime = getRelativeTime(daysCount);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop() ?? '';

const siteOrigin = 'https://luongnv89.github.io';
const canonicalUrl = `${siteOrigin}${Astro.url.pathname}`;
const ogImage = `${siteOrigin}${baseUrl}/brand/mark.svg`;
const metaDescription = frontmatter.summary;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#FAFAF7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0A1410" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        var theme = 'light';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            theme = 'dark';
          }
        } catch (e) { /* storage blocked — keep default */ }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <SecurityHeaders />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/brand/favicon.svg`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Awesome AI Cheatsheets" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <ConsentManager />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <SiteHeader />

    <main id="main-content" class="cheatsheet-main">
      <article
        class="cheatsheet"
        data-pagefind-body={isDraft ? undefined : true}
        data-pagefind-meta={isDraft
          ? undefined
          : `title:${frontmatter.title}, category:${frontmatter.category}, last_updated:${frontmatter.last_updated}`}
      >
        {stale && (
          <div class="stale-banner" role="alert">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <span>This cheatsheet may be stale (last updated {frontmatter.last_updated})</span>
          </div>
        )}

        <p class="cheatsheet-back">
          <a href={`${baseUrl}/`}>&larr; Back to catalog</a>
        </p>

        {/*
         * Sentinel + sticky header band.
         *
         * Issue #91 — the cheatsheet title must stay pinned at the top of
         * the viewport once the user scrolls past the full in-flow header.
         * We render the title twice (full + compact-sticky) — but only the
         * compact band is `position: sticky`, and it stays
         * `aria-hidden`/visually hidden until the IntersectionObserver
         * watching `.cheatsheet-header-sentinel` reports the full header
         * has scrolled out. This avoids any double-up at the top of the
         * page and keeps the compact band a single, dedicated DOM node
         * (no jank from animating an already-large header to compact).
         */}
        <div class="cheatsheet-header-sentinel" aria-hidden="true"></div>

        <header class="cheatsheet-header">
          <div class="cheatsheet-header-main">
            <span class={`catalog-category catalog-category-${frontmatter.category}`}>
              {frontmatter.category}
            </span>
            <h1 class="cheatsheet-title">{frontmatter.title}</h1>
            <p class="cheatsheet-summary">{frontmatter.summary}</p>
            <ul class="cheatsheet-meta" aria-label="Document metadata">
              {hasValidDate && (
                <li class="cheatsheet-meta-item">
                  <span class="freshness-chip" title={`Last updated: ${frontmatter.last_updated}`}>
                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span class="absolute-date">{frontmatter.last_updated}</span>
                    <span class="relative-date">({relativeTime})</span>
                  </span>
                </li>
              )}
              {stepCount > 0 && (
                <li class="cheatsheet-meta-item">{stepCount} steps</li>
              )}
              {stepMinutes > 0 && (
                <li class="cheatsheet-meta-item">~{stepMinutes} min total</li>
              )}
              {frontmatter.upstream_version && (
                <li class="cheatsheet-meta-item">{frontmatter.upstream_version}</li>
              )}
            </ul>
          </div>
          {frontmatter.tags.length > 0 && (
            <ul class="cheatsheet-tags" aria-label="tags">
              {frontmatter.tags.map((tag) => (
                <li class="cheatsheet-tag">{tag}</li>
              ))}
            </ul>
          )}
          <div class="share-buttons-row">
            <ShareButtons title={frontmatter.title} url={canonicalUrl} />
          </div>
        </header>

        {/*
         * Sticky compact title band — issue #91.
         *
         * Sits below the site header (`top: var(--site-header-h)`) so the
         * two sticky bars stack cleanly instead of fighting. The band is
         * invisible (visually hidden, aria-hidden, pointer-events:none)
         * until the IntersectionObserver on `.cheatsheet-header-sentinel`
         * flips `.is-active` on, at which point it slides into view.
         *
         * On wide viewports the band also carries an inline section
         * indicator on the right ("Section: <name>") synced to the
         * currently-visible h2 — a low-noise way to tell the reader where
         * they are in the article when the TOC aside is scrolled out.
         */}
        <div class="cheatsheet-sticky-header" aria-hidden="true">
          <div class="cheatsheet-sticky-header-inner">
            <span class={`catalog-category catalog-category-${frontmatter.category}`}>
              {frontmatter.category}
            </span>
            <h2 class="cheatsheet-sticky-title">{frontmatter.title}</h2>
            {stepCount > 0 && (
              <span class="cheatsheet-sticky-progress">
                <span
                  class="step-segments"
                  role="progressbar"
                  aria-label="Steps completed"
                  aria-valuemin={0}
                  aria-valuemax={stepCount}
                  aria-valuenow={0}
                >
                  {Array.from({ length: stepCount }, (_, i) => (
                    <span class="step-segment" data-step-segment={i + 1}></span>
                  ))}
                </span>
                <span class="cheatsheet-sticky-steps" data-steps-indicator></span>
              </span>
            )}
            <span class="cheatsheet-sticky-section" data-section-indicator></span>
          </div>
        </div>

        <div class="cheatsheet-content" data-slug={slug}>
          {/*
           * TOC aside — issue #92.
           *
           * Built client-side from the h2 headings in `.cheatsheet-body`
           * after the markdown content renders. Sits in the grid gutter at
           * ≥1024px and stays sticky alongside the reading column; on
           * narrow viewports the aside is removed from layout (CSS
           * `display: none` until 1024px) so the body has the full width.
           *
           * The script populates the <ol> on mount, or sets `hidden` on
           * the aside if the page has fewer than two h2s (a TOC of one
           * item is noise, not navigation). Rendered WITHOUT `hidden`
           * by default so the grid claim its 2-column shape on first
           * paint — avoids a CLS jump when JS finishes building the list.
           */}
          <aside class="cheatsheet-toc" aria-label="On this page">
            <p class="cheatsheet-toc-title">On this page</p>
            <ol class="cheatsheet-toc-list"></ol>
          </aside>
          <slot />
        </div>
      </article>
    </main>

    <SiteFooter />

    <MermaidLoader />
    <StepChecklist />
    <StickyToc />
    <CodeCopyButtons />
    <ContentEnhance />
  </body>
</html>
