---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['rounded-lg border bg-card text-card-foreground shadow-sm', className]}>
  <slot />
</div>

<style is:global>
  .rounded-lg { border-radius: 0.5rem; }
  .border { border-width: 1px; border-color: #e5e7eb; }
  .bg-card { background-color: #fff; }
  .text-card-foreground { color: #1f2937; }
  .shadow-sm { box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05); }
</style>