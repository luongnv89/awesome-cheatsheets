---
/**
 * Table of contents + sticky-header coordinator — issues #91 and #92.
 *
 * - Builds a TOC from h2 headings in `.cheatsheet-body` and inserts it
 *   into the `.cheatsheet-toc` aside. If the article has fewer than two
 *   h2s the aside is left hidden (a single-item TOC is noise).
 *
 * - Watches `.cheatsheet-header-sentinel` with IntersectionObserver to
 *   toggle `.cheatsheet-sticky-header.is-active` once the in-flow
 *   header has scrolled out. No scroll listener — IntersectionObserver
 *   is the right tool here: it fires only on threshold crossings, so
 *   the band can't flicker mid-scroll.
 *
 * - Watches each h2 with a second IntersectionObserver to:
 *     a) highlight the current section in the TOC,
 *     b) populate the inline section indicator in the sticky band.
 *
 * Reduced motion is respected via CSS (no transitions if the user has
 * `prefers-reduced-motion: reduce`).
 *
 * Extracted from `CheatsheetLayout.astro` (issue #133).
 */
---

<script>
  import { loadProgress } from './step-progress';

  const body = document.querySelector('.cheatsheet-body');
  const tocAside = document.querySelector('.cheatsheet-toc');
  const tocList = tocAside?.querySelector('.cheatsheet-toc-list');
  const stickyHeader = document.querySelector('.cheatsheet-sticky-header');
  const sentinel = document.querySelector('.cheatsheet-header-sentinel');
  const sectionIndicator = document.querySelector('[data-section-indicator]');

  /**
   * Read a heading's display label without the chrome StepChecklist
   * injects into the Setup H2 (the "k / N done" chip and the "Reset
   * progress" button). StepChecklist stamps `data-label` with the
   * original text before it injects — prefer that; otherwise clone the
   * heading and drop the injected side controls before reading text.
   */
  const headingText = (el) => {
    const label = el.getAttribute('data-label');
    if (label) return label;
    const clone = el.cloneNode(true);
    for (const node of clone.querySelectorAll('.step-header-side')) {
      node.remove();
    }
    return (clone.textContent ?? '').trim();
  };

  // -- TOC build --------------------------------------------------------
  /** @type {HTMLHeadingElement[]} */
  const h2s = body
    ? Array.from(body.querySelectorAll(':scope > h2'))
    : [];

  /**
   * Step sub-items under a section: the `.step` wrappers StepChecklist
   * built between this H2 and the next one. Each links to the step H3
   * anchor and gets a check mark once the step is done.
   */
  const stepLinks = [];
  const buildStepSublist = (h2, li) => {
    const sub = document.createElement('ol');
    sub.className = 'cheatsheet-toc-sublist';
    let sib = h2.nextElementSibling;
    let count = 0;
    while (sib && sib.tagName !== 'H2') {
      if (sib.classList?.contains('step')) {
        const h3 = sib.querySelector('h3.step-heading');
        const key = sib.dataset.stepKey;
        if (h3?.id && key) {
          const item = document.createElement('li');
          item.className = 'cheatsheet-toc-step';
          const a = document.createElement('a');
          a.href = `#${h3.id}`;
          a.className = 'cheatsheet-toc-step-link';
          a.dataset.stepKey = key;
          const check = document.createElement('span');
          check.className = 'toc-step-check';
          check.setAttribute('aria-hidden', 'true');
          const label = document.createElement('span');
          // `.step-title` holds the bare title StepChecklist extracted
          // from `### Step N — Title`; fall back to the step number.
          label.textContent =
            h3.querySelector('.step-title')?.textContent?.trim() ||
            `Step ${key.replace('step-', '')}`;
          a.appendChild(check);
          a.appendChild(label);
          item.appendChild(a);
          sub.appendChild(item);
          stepLinks.push(a);
          count += 1;
        }
      }
      sib = sib.nextElementSibling;
    }
    if (count > 0) li.appendChild(sub);
  };

  if (tocAside && tocList) {
    if (h2s.length >= 2) {
      for (const h2 of h2s) {
        if (!h2.id) continue;
        const text = headingText(h2);
        if (!text) continue;
        const li = document.createElement('li');
        li.className = 'cheatsheet-toc-item';
        const a = document.createElement('a');
        a.href = `#${h2.id}`;
        a.className = 'cheatsheet-toc-link';
        a.textContent = text;
        a.dataset.tocTarget = h2.id;
        li.appendChild(a);
        buildStepSublist(h2, li);
        tocList.appendChild(li);
      }
    }
    // Hide the aside if we ended up with <2 entries — keeps the grid
    // collapsed to a single column via `:has(.cheatsheet-toc[hidden])`
    // when there's nothing useful to show.
    if (tocList.children.length < 2) {
      tocAside.setAttribute('hidden', '');
    }
  }

  // -- Step check marks --------------------------------------------------
  // Initial state comes straight from storage (StepChecklist ran before
  // this script but its first progress event fired before we could
  // subscribe); later updates arrive via `cheatsheet:step-progress`.
  if (stepLinks.length > 0) {
    const slug =
      document.querySelector('.cheatsheet-content')?.getAttribute('data-slug') ??
      'unknown';
    const applyStepState = (state) => {
      for (const a of stepLinks) {
        const key = a.dataset.stepKey ?? '';
        a.classList.toggle('is-done', state[key] === true);
      }
    };
    applyStepState(loadProgress(() => localStorage, `cheatsheet-progress:${slug}`));
    document.addEventListener('cheatsheet:step-progress', (event) => {
      applyStepState(event.detail?.state ?? {});
    });
  }

  // -- Sticky-header toggle (issue #91) --------------------------------
  /** Assigned by the section tracker below so the band toggle can
      re-evaluate the current section once its own height joins the
      sticky chrome.
      @type {(() => void) | null} */
  let refreshCurrentSection = null;
  if (stickyHeader && sentinel) {
    const stickyObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          // Sentinel sits where the full header used to be. When it
          // leaves the top of the viewport (intersectionRatio drops to
          // 0 while boundingClientRect.top < 0), the compact band
          // takes over.
          const rect = entry.boundingClientRect;
          const active = !entry.isIntersecting && rect.top < 0;
          stickyHeader.classList.toggle('is-active', active);
          stickyHeader.setAttribute('aria-hidden', active ? 'false' : 'true');
          // The band adds ~44px of chrome when it appears — re-evaluate
          // which section is "current" against the new offset.
          refreshCurrentSection?.();
        }
      },
      { rootMargin: '0px', threshold: [0, 1] },
    );
    stickyObserver.observe(sentinel);
  }

  // -- Section indicator + TOC active-link (issue #92) ------------------
  if (h2s.length > 0) {
    /** @type {Map<string, HTMLAnchorElement | null>} */
    const linkByTarget = new Map();
    if (tocList) {
      for (const a of tocList.querySelectorAll('a.cheatsheet-toc-link')) {
        linkByTarget.set(a.dataset.tocTarget ?? '', a);
      }
    }

    /**
     * Bottom edge of the sticky chrome (site header + compact band once
     * it's active). An h2 counts as the current section as soon as its
     * top edge reaches this line — a heading parked directly under the
     * chrome must already report its own section, not the previous one.
     */
    const chromeOffset = () => {
      const header = document.querySelector('.site-header');
      let offset = (header?.offsetHeight ?? 0) + 8;
      if (stickyHeader?.classList.contains('is-active')) {
        offset += stickyHeader.offsetHeight;
      }
      return offset;
    };

    const setCurrent = () => {
      // The last h2 whose top edge has reached the chrome line (plus a
      // small buffer) is the section the reader is in.
      const limit = chromeOffset() + 16;
      let current = null;
      for (const h2 of h2s) {
        if (h2.getBoundingClientRect().top <= limit) current = h2;
        else break;
      }
      for (const a of linkByTarget.values()) {
        if (a) a.classList.remove('is-current');
      }
      if (current) {
        const text = headingText(current);
        if (sectionIndicator) sectionIndicator.textContent = text;
        const link = linkByTarget.get(current.id);
        if (link) link.classList.add('is-current');
      } else if (sectionIndicator) {
        sectionIndicator.textContent = '';
      }
    };
    refreshCurrentSection = setCurrent;

    // rAF-throttled scroll/resize tracking — an IntersectionObserver with
    // a fixed rootMargin can't express "reached the sticky chrome", since
    // the chrome height varies with breakpoint and band state.
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        setCurrent();
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    setCurrent();
  }
</script>
