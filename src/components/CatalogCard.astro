---
/**
 * Catalog list row for the landing page (`src/pages/index.astro`).
 *
 * Renders title, one-liner (summary), category, tags, last_updated, and an
 * inline "may be stale" badge when applicable. Uses class names scoped to the
 * catalog (`.catalog-*`) so it does NOT collide with the `.freshness-chip` /
 * `.stale-banner` selectors used by `CheatsheetLayout.astro` and asserted by
 * `e2e/freshness.test.ts`.
 *
 * The staleness rule itself is imported from `tools/utils/freshness.ts` so the
 * catalog and the detail page share exactly one source of truth (see the
 * unit tests under `tools/utils/__tests__/freshness.test.ts`).
 */
import { isStale } from "../../tools/utils/freshness.js";

interface Props {
  href: string;
  title: string;
  summary: string;
  category: "tool" | "mcp" | "concept" | "comparison";
  tags: string[];
  lastUpdated: string;
  staleAfterDays: number;
}

const { href, title, summary, category, tags, lastUpdated, staleAfterDays } =
  Astro.props;

const stale = isStale(lastUpdated, staleAfterDays);
---

<article class="catalog-card">
  <a class="catalog-card-link" href={href}>
    <header class="catalog-card-header">
      <h2 class="catalog-card-title">{title}</h2>
      <span class={`catalog-category catalog-category-${category}`}>
        {category}
      </span>
    </header>

    <p class="catalog-card-summary">{summary}</p>

    {tags.length > 0 && (
      <ul class="catalog-tags" aria-label="tags">
        {tags.map((tag) => (
          <li class="catalog-tag">{tag}</li>
        ))}
      </ul>
    )}

    <footer class="catalog-card-footer">
      <time class="catalog-last-updated" datetime={lastUpdated}>
        Updated {lastUpdated}
      </time>
      {stale && (
        <span class="catalog-stale-badge" role="status" aria-label="may be stale">
          may be stale
        </span>
      )}
    </footer>
  </a>
</article>

<style is:global>
  .catalog-card {
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    background-color: #fff;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .catalog-card:hover {
    border-color: #d1d5db;
    box-shadow: 0 4px 12px 0 rgba(0, 0, 0, 0.08);
  }

  .catalog-card-link {
    display: block;
    padding: 1.5rem;
    color: inherit;
    text-decoration: none;
  }

  .catalog-card-link:focus-visible {
    outline: 2px solid #2563eb;
    outline-offset: 2px;
    border-radius: 0.75rem;
  }

  .catalog-card-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .catalog-card-title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    color: #111827;
    margin: 0;
  }

  .catalog-category {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: capitalize;
    border: 1px solid transparent;
  }

  .catalog-category-tool {
    background-color: #dbeafe;
    color: #1e40af;
  }

  .catalog-category-mcp {
    background-color: #ede9fe;
    color: #5b21b6;
  }

  .catalog-category-concept {
    background-color: #dcfce7;
    color: #166534;
  }

  .catalog-category-comparison {
    background-color: #fef3c7;
    color: #92400e;
  }

  .catalog-card-summary {
    margin: 0 0 1rem 0;
    color: #4b5563;
    line-height: 1.5;
  }

  .catalog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1rem 0;
  }

  .catalog-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    background-color: #f3f4f6;
    color: #4b5563;
    font-size: 0.75rem;
  }

  .catalog-card-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    font-size: 0.875rem;
  }

  .catalog-last-updated {
    color: #6b7280;
  }

  .catalog-stale-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    background-color: #fef3c7;
    color: #92400e;
    border: 1px solid #fcd34d;
    font-size: 0.75rem;
    font-weight: 500;
  }
</style>
