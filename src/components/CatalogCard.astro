---
/**
 * Catalog list row for the landing page (`src/pages/index.astro`).
 *
 * Renders title, one-liner (summary), category, tags, last_updated, and an
 * inline "may be stale" badge when applicable. Uses class names scoped to the
 * catalog (`.catalog-*`) so it does NOT collide with the `.freshness-chip` /
 * `.stale-banner` selectors used by `CheatsheetLayout.astro` and asserted by
 * `e2e/freshness.test.ts`.
 *
 * The staleness rule itself is imported from `tools/utils/freshness.ts` so the
 * catalog and the detail page share exactly one source of truth (see the
 * unit tests under `tools/utils/__tests__/freshness.test.ts`).
 */
import { isStale } from "../../tools/utils/freshness.js";

interface Props {
  href: string;
  title: string;
  summary: string;
  category: "tool" | "mcp" | "concept" | "comparison";
  tags: string[];
  lastUpdated: string;
  staleAfterDays: number;
}

const { href, title, summary, category, tags, lastUpdated, staleAfterDays } =
  Astro.props;

const stale = isStale(lastUpdated, staleAfterDays);
---

<article class="catalog-card">
  <a class="catalog-card-link" href={href}>
    <header class="catalog-card-header">
      <h2 class="catalog-card-title">{title}</h2>
      <span class={`catalog-category catalog-category-${category}`}>
        {category}
      </span>
    </header>

    <p class="catalog-card-summary">{summary}</p>

    {tags.length > 0 && (
      <ul class="catalog-tags" aria-label="tags">
        {tags.map((tag) => (
          <li class="catalog-tag">{tag}</li>
        ))}
      </ul>
    )}

    <footer class="catalog-card-footer">
      <time class="catalog-last-updated" datetime={lastUpdated}>
        Updated {lastUpdated}
      </time>
      {stale && (
        <span class="catalog-stale-badge" role="status" aria-label="may be stale">
          may be stale
        </span>
      )}
    </footer>
  </a>
</article>

<style is:global>
  /*
   * .catalog-card — stacked-card motif evoking the brand mark (front card +
   * back card peeking out). The double box-shadow draws a subtle "second
   * card" silhouette below and to the right; on hover the front card lifts
   * with a brand-amber under-edge. Class names are asserted by
   * `e2e/catalog.test.ts` — do not rename.
   */
  .catalog-card {
    position: relative;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background-color: #fff;
    /* Stacked-card silhouette: two offset shadow layers shaped like the
       brand mark's back cards (deep navy, then a thinner amber accent). */
    box-shadow:
      6px 6px 0 -1px var(--color-paper-shade),
      6px 6px 0 0 var(--color-rule),
      0 1px 2px 0 rgba(27, 31, 58, 0.04);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  .catalog-card:hover {
    border-color: var(--color-ink-soft);
    transform: translate(-2px, -2px);
    box-shadow:
      8px 8px 0 -1px var(--color-paper-shade),
      8px 8px 0 0 var(--color-amber),
      0 6px 18px -6px rgba(27, 31, 58, 0.18);
  }

  .catalog-card-link {
    display: block;
    padding: 1.5rem;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-lg);
    height: 100%;
  }

  .catalog-card-link:focus-visible {
    outline: 2px solid var(--color-coral);
    outline-offset: 3px;
    border-radius: var(--radius-lg);
  }

  .catalog-card-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .catalog-card-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-ink);
    margin: 0;
    letter-spacing: -0.005em;
  }

  /*
   * Category pills — kept on the card AND used on detail pages (see
   * CheatsheetLayout.astro). Brand-aware tones built from the palette;
   * contrast verified against WCAG AA on the corresponding backgrounds.
   */
  .catalog-category {
    display: inline-flex;
    align-items: center;
    padding: 0.1875rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: capitalize;
    border: 1px solid transparent;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .catalog-category-tool       { background-color: #FFF4CC; color: #6F5300; border-color: #F2DD8A; }
  .catalog-category-mcp        { background-color: #E6E1FF; color: #2E2280; border-color: #C2B7F2; }
  .catalog-category-concept    { background-color: #D9F3DE; color: #1B5B2B; border-color: #A8DAB1; }
  .catalog-category-comparison { background-color: #FFE3DF; color: #8A2A1F; border-color: #F2A99F; }

  .catalog-card-summary {
    margin: 0 0 1rem 0;
    color: var(--color-muted);
    line-height: 1.55;
    font-size: 0.9375rem;
  }

  .catalog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1rem 0;
  }

  .catalog-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    background-color: var(--color-paper-shade);
    color: var(--color-ink);
    font-size: 0.75rem;
    font-family: var(--font-mono);
  }

  .catalog-card-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8125rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-rule);
  }

  .catalog-last-updated {
    color: var(--color-muted);
    font-family: var(--font-mono);
  }

  .catalog-stale-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    background-color: #fef3c7;
    color: #92400e;
    border: 1px solid #fcd34d;
    font-size: 0.75rem;
    font-weight: 600;
  }
</style>
