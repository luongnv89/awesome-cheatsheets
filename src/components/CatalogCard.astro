---
/**
 * Catalog card — one cheatsheet tile in the catalog grid.
 *
 * Layout: category outline pill + freshness date in the header, serif
 * title, a 2-line clamped summary, up to 4 tags (+N overflow), and a
 * footer carrying the step count, a localStorage-driven progress strip
 * (`cheatsheet-progress:<slug>` — hydrated by the script in index.astro),
 * and the stale badge. The whole card is a single link.
 *
 * Props stay flat (no object) so `index.astro` can loop over collection
 * entries without intermediate mapping types.
 */
import { isStale } from '../../tools/utils/freshness.js';

interface Props {
  href: string;
  title: string;
  summary: string;
  category: 'tool' | 'mcp' | 'concept' | 'comparison';
  tags: string[];
  /** Collection entry id — same value the detail page uses for the
      `cheatsheet-progress:<slug>` localStorage key. */
  slug: string;
  /** Number of `### Step N —` headings in the entry body (0 = none). */
  stepCount: number;
  lastUpdated: string;
  staleAfterDays: number;
}

const { href, title, summary, category, tags, slug, stepCount, lastUpdated, staleAfterDays } =
  Astro.props;

const stale = isStale(lastUpdated, staleAfterDays);

const MAX_TAGS = 4;
const visibleTags = tags.slice(0, MAX_TAGS);
const extraTags = tags.length - visibleTags.length;
---

<article class="catalog-card">
  <a class="catalog-card-link" href={href}>
    <header class="catalog-card-header">
      <span class={`catalog-category catalog-category-${category}`}>{category}</span>
      <time class="catalog-last-updated" datetime={lastUpdated}>
        Updated {lastUpdated}
      </time>
    </header>
    <h2 class="catalog-card-title">{title}</h2>
    <p class="catalog-card-summary">{summary}</p>
    {tags.length > 0 && (
      <ul class="catalog-tags" role="list">
        {visibleTags.map((tag) => <li class="catalog-tag">{tag}</li>)}
        {extraTags > 0 && <li class="catalog-tag catalog-tag-more">+{extraTags}</li>}
      </ul>
    )}
    <footer class="catalog-card-footer">
      <span class="catalog-card-meta">
        <span class="catalog-card-steps">
          {stepCount > 0 ? `${stepCount} steps` : 'Quick reference'}
        </span>
        <span
          class="catalog-card-progress"
          data-progress-slug={slug}
          data-step-count={stepCount}
          hidden
        >
          <span class="catalog-card-progress-track" aria-hidden="true">
            <span class="catalog-card-progress-fill"></span>
          </span>
          <span class="catalog-card-progress-label"></span>
        </span>
      </span>
      {stale && (
        <span class="catalog-stale-badge" role="status" aria-label="may be stale">
          may be stale
        </span>
      )}
    </footer>
  </a>
</article>

<style>
  /*
   * Card — white surface on the warm paper background, 12px radius, soft
   * shadow, and a 2px lift + neon top edge on hover. Colours come from
   * `src/styles/tokens.css`; `daysSince`/`stale` arrive precomputed so the
   * template is a pure function of props.
   */
  .catalog-card {
    height: 100%;
  }
  .catalog-card-link {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.125rem 1.25rem 1rem;
    background-color: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  /* Neon top edge — only on hover, and only ever a line. */
  .catalog-card-link::before {
    content: "";
    position: absolute;
    top: 0;
    left: 12px;
    right: 12px;
    height: 2px;
    border-radius: 2px;
    background-color: var(--accent-line);
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .catalog-card-link:hover {
    transform: translateY(-2px);
    border-color: var(--rule);
    box-shadow: var(--shadow-card-hover);
  }
  .catalog-card-link:hover::before {
    opacity: 1;
  }
  .catalog-card-link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .catalog-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  /* Category pill — tint-free outline so it reads in both themes. The
     same four variants are defined in cheatsheet.css for the detail page
     header; keep the colour tokens in sync. */
  .catalog-category {
    display: inline-flex;
    align-items: center;
    padding: 0.1875rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: capitalize;
    border: 1px solid currentColor;
    letter-spacing: 0.02em;
    white-space: nowrap;
    background-color: transparent;
  }
  .catalog-category-tool       { color: var(--cat-tool); }
  .catalog-category-mcp        { color: var(--cat-mcp); }
  .catalog-category-concept    { color: var(--cat-concept); }
  .catalog-category-comparison { color: var(--cat-comparison); }

  .catalog-last-updated {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    white-space: nowrap;
  }

  .catalog-card-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 0.45rem;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .catalog-card-link:hover .catalog-card-title {
    text-decoration: underline;
    text-decoration-color: var(--accent-line);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .catalog-card-summary {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted);
    margin: 0 0 0.75rem;
    /* 2-line clamp — long summaries stay consistent with the grid. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .catalog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0 0 0.875rem;
    padding: 0;
  }
  .catalog-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    border: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.72rem;
    font-family: var(--font-mono);
  }
  .catalog-tag-more {
    color: var(--accent-text);
    border-color: var(--accent-text);
  }

  /* Footer — pinned to the card bottom so the strip and stale badge align
     across a grid row regardless of summary length. */
  .catalog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.6rem;
    border-top: 1px solid var(--rule);
  }
  .catalog-card-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }
  .catalog-card-steps {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    white-space: nowrap;
  }
  /* Progress strip — hidden by default; the hydration script in
     index.astro unhides it when `cheatsheet-progress:<slug>` has ≥1
     checked step and sets the fill width + "k/N done" label. */
  .catalog-card-progress {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
  }
  .catalog-card-progress[hidden] { display: none; }
  .catalog-card-progress-track {
    display: inline-block;
    width: 3.5rem;
    height: 3px;
    border-radius: 2px;
    background-color: var(--rule);
    overflow: hidden;
  }
  .catalog-card-progress-fill {
    display: block;
    height: 100%;
    background-color: var(--accent-line);
    border-radius: 2px;
  }
  .catalog-card-progress-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--accent-text);
    white-space: nowrap;
  }

  .catalog-stale-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    border: 1px solid var(--warning);
    color: var(--warning);
    white-space: nowrap;
  }
</style>
